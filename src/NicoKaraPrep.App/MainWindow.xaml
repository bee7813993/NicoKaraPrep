<Window
    x:Class="NicoKaraPrep.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels"
    xmlns:views="using:NicoKaraPrep.App.Views"
    xmlns:fs="using:NicoKaraPrep.App.Views.FontSettings"
    xmlns:core="using:NicoKaraPrep.Core.Model"
    xmlns:val="using:NicoKaraPrep.Core.Validation">

    <!-- 画面の大きさに合わせた並べ方（プレイヤーの高さ・右のパネルの幅・行リストの列・行設定の段）は MainWindow.Layout.cs -->
    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- メニューとビューの切り替え -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- メニュー -->
            <MenuBar Grid.Column="0">
                <MenuBarItem Title="ファイル(F)" AccessKey="F">
                    <MenuFlyoutItem Text="新規作成（ファイルを閉じる）" Click="OnNewClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="開く..." Click="OnOpenClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="RecentFilesMenu" Text="最近使用したファイル" />
                    <MenuFlyoutItem Text="ニコカラメーカー3 プロジェクト(n3proj)を読み込み..." Click="OnImportN3ProjClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="上書き保存（タブ含む全行）" Click="OnSaveClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="名前を付けて保存（タブ含む全行）..." Click="OnSaveAsClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="表示中のタブを上書き保存" Click="OnSaveTabOverwriteClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="表示中のタブを別ファイルへ保存..." Click="OnSaveTabAsClick" />
                    <MenuFlyoutItem Text="表示中のタブへファイルを読み込み（差し替え）..." Click="OnReloadTabClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="クリップボードから貼り付け" Click="OnPasteClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="V" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="テキスト編集モード形式でコピー" Click="OnCopyClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="C" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="設定..." Click="OnSettingsClick" />
                    <MenuFlyoutItem Text="キー割り当て（挿入ビュー）..." Click="OnKeyBindingsClick" />
                    <MenuFlyoutItem Text="Claude と連携..." Click="OnClaudeLinkClick" ToolTipService.ToolTip="Claude（Claude Desktop・Claude Code）から、このアプリを操作できるように登録します" />
                </MenuBarItem>
                <MenuBarItem Title="編集(E)" AccessKey="E">
                    <MenuFlyoutItem Text="元に戻す" Click="OnUndoClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Z" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="やり直し" Click="OnRedoClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Y" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="カーソル位置で行分割" Click="OnSplitLineClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="次の行と結合" Click="OnJoinLineClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="J" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="次の行と結合（スペースを挟む）" Click="OnJoinLineWithSpaceClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="J" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="空行（ページ区切り）を下に挿入" Click="OnInsertEmptyLineClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="K" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="選択行を削除" Click="OnDeleteLinesClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Delete" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="表示(V)" AccessKey="V">
                    <RadioMenuFlyoutItem
                        x:Name="LinesViewMenuItem"
                        Text="行リスト"
                        GroupName="MainViewMode"
                        Click="OnViewMenuClick" />
                    <RadioMenuFlyoutItem
                        x:Name="EmojiViewMenuItem"
                        Text="絵文字挿入ビュー"
                        GroupName="MainViewMode"
                        Click="OnViewMenuClick">
                        <RadioMenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F2" Invoked="OnViewAcceleratorInvoked" />
                        </RadioMenuFlyoutItem.KeyboardAccelerators>
                    </RadioMenuFlyoutItem>
                    <RadioMenuFlyoutItem
                        x:Name="FontViewMenuItem"
                        Text="フォント設定ビュー"
                        GroupName="MainViewMode"
                        Click="OnViewMenuClick">
                        <RadioMenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F3" Invoked="OnViewAcceleratorInvoked" />
                        </RadioMenuFlyoutItem.KeyboardAccelerators>
                    </RadioMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Esc で今のビューを閉じて戻る（絵文字挿入ビューは行リストへ、フォント設定ビューは直前のビューへ）。
                         項目名は今のビューに合わせて変える（MainWindow.Views.cs の SyncViewSwitchers）。
                         Esc は各ビューの中で受ける（フォント設定ビューでは中の部品が処理しなかったときだけ）ため、ここはキーの表示だけ -->
                    <MenuFlyoutItem
                        x:Name="BackViewMenuItem"
                        Text="前のビューへ戻る"
                        KeyboardAcceleratorTextOverride="Esc"
                        IsEnabled="False"
                        Click="OnBackViewMenuClick" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem
                        x:Name="StyledLyricsMenuItem"
                        Text="行リストの歌詞を字幕の見た目で表示"
                        Click="OnStyledLyricsMenuClick" />
                    <MenuFlyoutSeparator />
                    <!-- 画面の並べ方（低い画面では、メディア再生を右に置くと行リストを縦に広く使える。自動は窓の高さで決める） -->
                    <MenuFlyoutSubItem x:Name="PlayerPlacementMenu" Text="メディア再生の置き場所">
                        <RadioMenuFlyoutItem
                            x:Name="PlayerPlacementAutoItem"
                            Text="自動（窓が低いときは右の列）"
                            GroupName="PlayerPlacement"
                            Click="OnPlayerPlacementMenuClick"
                            ToolTipService.ToolTip="窓の高さが 1100 より低いとき（FHD の画面など）は右の列、高いときは上の段に置きます。窓の大きさを変えると切り替わります" />
                        <RadioMenuFlyoutItem
                            x:Name="PlayerPlacementTopItem"
                            Text="上の段（横いっぱい）"
                            GroupName="PlayerPlacement"
                            Click="OnPlayerPlacementMenuClick" />
                        <RadioMenuFlyoutItem
                            x:Name="PlayerPlacementRightItem"
                            Text="右の列（行リストを縦に広く）"
                            GroupName="PlayerPlacement"
                            Click="OnPlayerPlacementMenuClick" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem
                        x:Name="SidePanelMenuItem"
                        Text="右のパネル（フォント・レイアウト／絵文字のパレット）を表示"
                        Click="OnSidePanelMenuClick" />
                </MenuBarItem>
                <MenuBarItem Title="エクスポート(X)" AccessKey="X">
                    <MenuFlyoutItem Text="選択行を新しいタブへ分離" Click="OnSplitToTabClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="T" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="タブ分離を解除（すべてメインへ戻す）" Click="OnResetTabsClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="選択行をエクスポート..." Click="OnExportFileClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="E" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="選択行をクリップボードへエクスポート" Click="OnExportClipboardClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="未エクスポート行をすべて選択" Click="OnSelectUnexportedClick" />
                    <MenuFlyoutItem Text="選択行の済マークを解除" Click="OnClearMarksClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="ニコカラメーカー3 プロジェクト(n3proj)を書き出し..." Click="OnExportN3ProjClick" />
                    <MenuFlyoutItem Text="ニコカラメーカー3 のフォント設定を編集" KeyboardAcceleratorTextOverride="F3" Click="OnFontSettingsViewClick" />
                    <MenuFlyoutItem Text="選択行の表示時刻・フォント指定を解除" Click="OnClearN3OverridesClick" ToolTipService.ToolTip="選んだ行の、ニコカラメーカー用の行設定（表示時刻・フォント・レイアウト・文字の大きさ）をまとめて解除します。表示時刻は、手で直した値も読み込んだ値・自動調整の値も外して、自動の計算に戻します" />
                </MenuBarItem>
                <MenuBarItem Title="再生(P)" AccessKey="P">
                    <MenuFlyoutItem Text="メディアを開く..." Click="OnOpenMediaClick" />
                    <MenuFlyoutItem Text="再生 / 一時停止" Click="OnPlayPauseClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Space" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="5秒戻る" Click="OnSeekBackClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Left" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="5秒進む" Click="OnSeekForwardClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Right" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="FollowToggle" Text="再生位置に追従してハイライト" IsChecked="True" />
                </MenuBarItem>
                <MenuBarItem Title="絵文字(G)" AccessKey="G">
                    <MenuFlyoutItem Text="絵文字リスト編集..." Click="OnEmojiListClick" />
                    <MenuFlyoutItem Text="絵文字タイムタグ再計算" Click="OnEmojiRetagClick" />
                </MenuBarItem>
                <MenuBarItem Title="チェック(C)" AccessKey="C">
                    <MenuFlyoutItem Text="今すぐチェック" Click="OnValidateClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="テンプレート(T)" AccessKey="T">
                    <MenuFlyoutItem Text="テンプレートとして保存...（絵文字一式＋字幕フォント・チェック設定）" Click="OnSaveTemplateClick" />
                    <MenuFlyoutItem Text="テンプレートを読み込み..." Click="OnLoadTemplateClick" />
                </MenuBarItem>
            </MenuBar>

            <!-- ビューの切り替え（表示メニュー・F2・F3 と同じ。選択は ViewModel.ViewMode に追従） -->
            <SelectorBar
                x:Name="ViewSelector"
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                SelectionChanged="OnViewSelectorChanged">
                <SelectorBarItem x:Name="LinesViewTab" Text="行リスト" ToolTipService.ToolTip="行リスト（行ごとの編集）" />
                <SelectorBarItem x:Name="EmojiViewTab" Text="絵文字挿入" ToolTipService.ToolTip="絵文字挿入ビュー (F2)" />
                <SelectorBarItem x:Name="FontViewTab" Text="フォント設定" ToolTipService.ToolTip="ニコカラメーカー3 のフォント設定ビュー (F3)" />
            </SelectorBar>
        </Grid>

        <!-- メイン（上: メディア再生 / 下: 左に行リストか絵文字挿入ビュー・つまみ・右のパネル） -->
        <Grid Grid.Row="1" x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- メディア再生パネル（見出しと中の余白は既定より薄くして、低い画面でも行リストの高さを残す）。
                 ふつうは上の段の横いっぱい。「メディア再生を右に置く」では右の列の上（MainWindow.Layout.cs の ApplyPlayerPlacement） -->
            <Expander
                Grid.Row="0"
                Grid.ColumnSpan="3"
                x:Name="MediaPanel"
                Header="メディア再生（動画・音声ファイルをここにドロップで読み込み）"
                MinHeight="32"
                Padding="8,4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AllowDrop="True"
                DragOver="OnMediaDragOver"
                Drop="OnMediaDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 動画と字幕のプレビュー（再生の操作は下の行に出して、字幕に重ならないようにする） -->
                    <Grid x:Name="PlayerHost" Height="260" Background="Black">
                        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" />
                        <views:SubtitlePreviewView x:Name="SubtitlePreview" />
                    </Grid>
                    <!-- 再生の操作: 再生・一時停止と位置（左）、音量と字幕プレビューの切り替え（右）。
                         右の列に置くときは、位置のスライダーを 1 段目の横いっぱいに、ほかを 2 段目にする -->
                    <Grid Grid.Row="1" x:Name="PlayerBar" Padding="0,6,0,0" ColumnSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayPauseButton" Padding="12,5" Click="OnPlayPauseClick" ToolTipService.ToolTip="再生 / 一時停止（Ctrl+Space）">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="PlayerTimeText" Text="0:00.00" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="再生位置" />
                        <Slider Grid.Column="2" x:Name="PlayerSeekSlider" Minimum="0" Maximum="1" StepFrequency="0.01" IsThumbToolTipEnabled="False"
                                VerticalAlignment="Center" ValueChanged="OnPlayerSeekChanged" ToolTipService.ToolTip="ドラッグで再生位置を移動" />
                        <TextBlock Grid.Column="3" x:Name="PlayerDurationText" Text="0:00" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="長さ" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="音量">
                            <FontIcon Glyph="&#xE767;" FontSize="14" VerticalAlignment="Center" />
                            <Slider x:Name="PlayerVolumeSlider" Width="96" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="OnPlayerVolumeChanged" />
                        </StackPanel>
                        <ToggleButton Grid.Column="5" x:Name="SubtitlePreviewToggle" Content="字幕プレビュー" Padding="10,5" Click="OnSubtitlePreviewToggleClick"
                                      ToolTipService.ToolTip="動画の上に、ニコカラメーカー3 での字幕の見え方（近似。フェードなどの字幕アクションは無し）を重ねます" />
                    </Grid>
                    <!-- 高さ変更ハンドル（右に置くときは隠す。高さは幅から決める） -->
                    <Border
                        Grid.Row="2"
                        x:Name="PlayerResizeHandle"
                        Height="10"
                        Background="Transparent"
                        ManipulationMode="TranslateY"
                        ManipulationDelta="OnPlayerResizeDelta"
                        ManipulationCompleted="OnPlayerResizeCompleted"
                        ToolTipService.ToolTip="ドラッグでプレイヤーの高さを変更">
                        <Rectangle
                            Width="48"
                            Height="4"
                            RadiusX="2"
                            RadiusY="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                    </Border>
                </Grid>
            </Expander>

            <!-- 行リストのビュー（ドキュメントタブ・行リスト・行エディタ・行設定・行プレビュー） -->
            <Grid Grid.Row="1" Grid.Column="0" x:Name="NormalView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ドキュメントタブ（メイン＋分離タブ。ダブルクリックで名前変更） -->
                <TabView
                    x:Name="DocTabs"
                    Grid.Row="0"
                    IsAddTabButtonVisible="False"
                    CanReorderTabs="False"
                    CanDragTabs="False"
                    TabWidthMode="SizeToContent"
                    TabItemsSource="{x:Bind ViewModel.Tabs}"
                    SelectionChanged="OnTabSelectionChanged"
                    TabCloseRequested="OnTabCloseRequested"
                    DoubleTapped="OnTabDoubleTapped">
                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="vm:TabState">
                            <TabViewItem Header="{x:Bind Name, Mode=OneWay}" IsClosable="{x:Bind IsClosable}" ToolTipService.ToolTip="{x:Bind ToolTipText}" />
                        </DataTemplate>
                    </TabView.TabItemTemplate>
                    <TabView.TabStripFooter>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                            <Button
                                Content="選択行を分離"
                                FontSize="12"
                                Padding="8,4"
                                Click="OnSplitToTabClick"
                                ToolTipService.ToolTip="選択した行を新しいタブへ移動します (Ctrl+T)" />
                            <DropDownButton
                                Content="選択行を移動"
                                FontSize="12"
                                Padding="8,4"
                                ToolTipService.ToolTip="選択した行を既存のタブへ移動します（時刻順に挿入）">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="MoveToTabFlyout" Opening="OnMoveToTabFlyoutOpening" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </TabView.TabStripFooter>
                </TabView>

                <!-- 行リスト -->
                <ListView
                    x:Name="LineList"
                    Grid.Row="1"
                    AllowDrop="True"
                    DragOver="OnDragOver"
                    Drop="OnDrop"
                    ItemsSource="{x:Bind ViewModel.Lines}"
                    SelectionMode="Extended"
                    SelectionChanged="OnLineSelectionChanged"
                    DoubleTapped="OnLineDoubleTapped"
                    RightTapped="OnLineRightTapped">
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="LineContextMenu" Opening="OnLineContextMenuOpening">
                            <MenuFlyoutItem Text="選択行を新しいタブへ分離" Click="OnSplitToTabClick" />
                            <MenuFlyoutSubItem x:Name="MoveToTabSub" Text="選択行を既存のタブへ移動" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="選択行をエクスポート..." Click="OnExportFileClick" />
                            <MenuFlyoutItem Text="選択行をクリップボードへエクスポート" Click="OnExportClipboardClick" />
                            <MenuFlyoutItem Text="選択行の済マークを解除" Click="OnClearMarksClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="空行（ページ区切り）を下に挿入" Click="OnInsertEmptyLineClick" />
                            <MenuFlyoutItem Text="選択行を削除" Click="OnDeleteLinesClick" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LineViewModel">
                            <!-- 列: 選択 / 済・行番号 / 時刻（上の段に歌い出し・歌い終わり、下の段に表示開始・表示終了）/ 印（♪ 重なり・横幅の判定）/ 横幅 /
                                 手動指定 / フォント・レイアウト / 歌詞。列の幅は vm:LineListLayout（MainWindow.Layout.cs）。フォント・レイアウトの欄は行の中身に合わせ、
                                 行リストが狭いときは横幅を 2 段にし、フォントの欄を狭めて歌詞の欄を広く取る -->
                            <Grid Opacity="{x:Bind Opacity, Mode=OneWay}" ColumnSpacing="6" Background="{x:Bind RowBrush, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="{x:Bind vm:LineListLayout.Current.TimeColumnWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="{x:Bind vm:LineListLayout.Current.WidthColumnWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="{x:Bind vm:LineListLayout.Current.FontColumnWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0" Padding="0" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="OnRowCheckClick" Tag="{x:Bind}" ToolTipService.ToolTip="選択（複数選択してエクスポートなどに使用）" />
                                <!-- 済（エクスポート済み）は左、行番号は右寄せ（時間のすぐ左にそろえる） -->
                                <Grid Grid.Column="1">
                                    <TextBlock Text="{x:Bind ExportedMark, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" ToolTipService.ToolTip="エクスポート済み" />
                                    <TextBlock Text="{x:Bind IndexText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <!-- 時刻: 上の段に歌い出し・歌い終わり（行の最初・最後のタイムタグ）、下の段に表示開始・表示終了（ニコカラメーカーで行を出す・消す時刻。
                                     行設定の説明・書き出しと同じ計算）。左が開始、右が終了。ダブルクリックで、下の行設定の表示開始・表示終了の欄へカーソルを移す
                                     （今の表示時刻を入れて選ぶ）。列の幅は LineListLayout の TimeCellWidth と同じ -->
                                <Grid Grid.Column="2" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" FontFamily="Consolas" Foreground="{x:Bind StartTimeBrush, Mode=OneWay}" DoubleTapped="OnLineStartTimeDoubleTapped"
                                               ToolTipService.ToolTip="歌い出し（行の最初のタイムタグ）。下の段は表示開始。チェックで表示開始に問題があれば色が付きます。ダブルクリックで、下の行設定の表示開始を直せます" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind EndTimeText, Mode=OneWay}" FontFamily="Consolas" Foreground="{x:Bind EndTimeBrush, Mode=OneWay}" DoubleTapped="OnLineEndTimeDoubleTapped"
                                               ToolTipService.ToolTip="歌い終わり（行の最後のタイムタグ）。下の段は表示終了。チェックで表示終了に問題があれば色が付きます。ダブルクリックで、下の行設定の表示終了を直せます" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind ShowBeginText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{x:Bind ShowBeginBrush, Mode=OneWay}"
                                               DoubleTapped="OnLineStartTimeDoubleTapped" ToolTipService.ToolTip="{x:Bind ShowBeginToolTip, Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ShowEndText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{x:Bind ShowEndBrush, Mode=OneWay}"
                                               DoubleTapped="OnLineEndTimeDoubleTapped" ToolTipService.ToolTip="{x:Bind ShowEndToolTip, Mode=OneWay}" />
                                </Grid>
                                <!-- 印: 上に ♪（タイムタグの重なり）、下に横幅の判定（どちらも出ないことが多いので 1 つの欄にまとめる） -->
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{x:Bind OverlapGlyph, Mode=OneWay}" ToolTipService.ToolTip="同時歌唱などのタイムタグ重なりあり（正常）" />
                                    <TextBlock Text="{x:Bind WidthGlyph, Mode=OneWay}" ToolTipService.ToolTip="横幅チェック結果" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{x:Bind WidthText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{x:Bind WidthBrush, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind WidthToolTip, Mode=OneWay}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind OverrideMark, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" ToolTipService.ToolTip="ニコカラメーカー用の手動指定（表示時刻・フォント・レイアウト・文字の大きさ）あり" />
                                <!-- この行に当たるフォント設定（書き出しと同じ決め方。途中で切り替わる行は最初と最後を → でつなぐ）と、下の段にこの行のページのレイアウト。
                                     中の大きさを変えたら MainWindow.Layout.cs の FontCellWidth も合わせる -->
                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Spacing="1">
                                    <Grid ColumnSpacing="4" Background="Transparent" Visibility="{x:Bind AppliedFont.IsVisible, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind AppliedFont.ToolTip, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Border Width="8" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind AppliedFont.First.After, Mode=OneWay}" />
                                            <Border Width="8" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind AppliedFont.First.Before, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind AppliedFont.First.Name, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind AppliedFont.HasLast, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind AppliedFont.Arrow, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Border Width="8" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind AppliedFont.Last.After, Mode=OneWay}" />
                                                <Border Width="8" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind AppliedFont.Last.Before, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind AppliedFont.Last.Name, Mode=OneWay}" FontSize="12" MaxWidth="72" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind LayoutText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind HasLayoutText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind LayoutToolTip, Mode=OneWay}" />
                                </StackPanel>
                                <!-- 歌詞: 字幕の見た目（フォント設定の書体・配色・ルビ・アイコン）で描く。文字をクリック・ドラッグで選べる。空行・タグだけの行と、表示を切ったときは文字のまま -->
                                <Grid Grid.Column="7">
                                    <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ShowPlainText, Mode=OneWay}" />
                                    <views:LyricLineView Height="44" Line="{x:Bind}" Visibility="{x:Bind ShowStyledText, Mode=OneWay}" CharSelecting="OnLyricCharSelecting" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 行エディタ -->
                <Grid Grid.Row="2" Padding="8,4" ColumnSpacing="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="LineEditor"
                        Grid.Column="0"
                        AcceptsReturn="False"
                        FontFamily="Consolas"
                        PlaceholderText="行を選択すると編集できます"
                        PreviewKeyDown="OnLineEditorPreviewKeyDown"
                        KeyDown="OnLineEditorKeyDown" />
                    <Button Grid.Column="1" Content="適用" Click="OnApplyLineClick" VerticalAlignment="Stretch" />
                </Grid>

                <!-- ニコカラメーカー用の行設定（表示開始・終了の手動指定、フォント設定名、レイアウト。n3proj 書き出しに反映）。
                     1 行に収まらないときは、フォント・レイアウトを 2 段目に回す（MainWindow.Layout.cs の FitN3LinePanel） -->
                <Grid
                    Grid.Row="3"
                    x:Name="N3LinePanel"
                    Padding="8,4"
                    ColumnSpacing="14"
                    RowSpacing="4"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="N3TimeGroup" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="ニコカラメーカー用:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   ToolTipService.ToolTip="n3proj 書き出し時にこの行へ適用される表示開始・終了時刻とフォント設定。表示時刻の欄が空なら薄字の値（読み込んだ値・自動調整の値・自動計算）を使います。表示時刻はページ衝突チェックにも反映されます" />
                        <TextBlock Text="表示開始" FontSize="12" VerticalAlignment="Center" />
                        <TextBox x:Name="ShowBeginBox" Width="104" FontFamily="Consolas" FontSize="12" PlaceholderText="--:--:--"
                                 LostFocus="OnShowTimeBoxLostFocus" KeyDown="OnShowTimeBoxKeyDown" ToolTipService.ToolTip="mm:ss:cc 形式で手で指定（自動調整を実行し直しても変わりません）。空欄なら薄字の値（読み込んだ値・自動調整の値・自動計算）を使います" />
                        <TextBlock Text="表示終了" FontSize="12" VerticalAlignment="Center" />
                        <TextBox x:Name="ShowEndBox" Width="104" FontFamily="Consolas" FontSize="12" PlaceholderText="--:--:--"
                                 LostFocus="OnShowTimeBoxLostFocus" KeyDown="OnShowTimeBoxKeyDown" ToolTipService.ToolTip="mm:ss:cc 形式で手で指定（自動調整を実行し直しても変わりません）。空欄なら薄字の値（読み込んだ値・自動調整の値・自動計算）を使います" />
                        <Button Content="自動に戻す" FontSize="12" Padding="8,3" Click="OnResetShowTimeClick" />
                    </StackPanel>
                    <StackPanel x:Name="N3FontGroup" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="LineFontLabel" Text="フォント" FontSize="12" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="行リストの歌詞の文字をクリック・ドラッグで選ぶと、選んだ文字だけに指定します（選んでいなければ行全体）" />
                        <ComboBox x:Name="LineFontBox" Width="160" IsEditable="True" FontSize="12" PlaceholderText="（自動）"
                                  SelectionChanged="OnLineFontChanged" TextSubmitted="OnLineFontSubmitted" PreviewKeyDown="OnLineFontPreviewKeyDown"
                                  ToolTipService.ToolTip="この行に適用するニコカラメーカーのフォント設定名（空欄はパート記号で自動判定。空にして Enter で自動に戻す）" />
                        <Button x:Name="EditLineFontButton" Content="編集..." FontSize="12" Padding="8,3" Click="OnEditLineFontClick"
                                ToolTipService.ToolTip="フォント設定ビュー（F3）を開いて、このフォント設定を編集します" />
                        <TextBlock Text="レイアウト" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                   ToolTipService.ToolTip="この行のページに使うニコカラメーカーのレイアウト設定（ページ単位。自動はページの行数から選びます）" />
                        <ComboBox x:Name="LineLayoutBox" Width="140" FontSize="12" PlaceholderText="（自動）"
                                  SelectionChanged="OnLineLayoutChanged"
                                  ToolTipService.ToolTip="この行のページに使うレイアウト設定（「（自動）」でページの行数から選ぶ。同じページの行すべてに効きます）" />
                        <!-- ページの文字の大きさの増減（ニコカラメーカー3 には無い機能。書き出しで大きさだけを変えたフォント設定を作る） -->
                        <TextBlock Text="文字の大きさ" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                   ToolTipService.ToolTip="この行のページの文字の大きさを、フォント設定の文字サイズに足す px（マイナスで小さく。0 でそのまま。ページ単位で、同じページの行すべてに効きます）" />
                        <NumberBox x:Name="PageFontSizeBox" Width="96" FontSize="12" Value="0" Minimum="-100" Maximum="200" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Compact" ValueChanged="OnPageFontSizeChanged"
                                   ToolTipService.ToolTip="ページの文字の大きさの増減 px（+4 で 4px 大きく）。書き出しでは、文字に当たるフォント設定を、文字の大きさだけを変えたもの（「（麻衣）+4」のように名前の後ろに増減を付けたもの）にして足します。ルビは歌詞と同じ割合で変わり、縁の幅は変わりません" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="N3LineInfo" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- 行プレビュー（ルビ・絵文字画像） -->
                <ScrollViewer
                    Grid.Row="4"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    Padding="8,0"
                    MaxHeight="88"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel x:Name="PreviewPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" />
                </ScrollViewer>
            </Grid>

            <!-- 絵文字挿入ビュー（F2、歌詞全体表示・キーボード専用） -->
            <Grid Grid.Row="1" Grid.Column="0" x:Name="InsertView" Visibility="Collapsed" Padding="8" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="絵文字挿入ビュー" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="FollowIndicator"
                        Text="追従 OFF (F)"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Content="キー一覧..."
                        FontSize="12"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Click="OnKeyBindingsClick"
                        ToolTipService.ToolTip="キーボード配列でキー操作の一覧を表示（クリックで割り当て変更も可能）" />
                </StackPanel>
                <TextBlock
                    x:Name="InsertLegend"
                    Grid.Row="1"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 行の実高さ測定用プローブ（エディタと同一のフォント設定、不可視） -->
                    <TextBox
                        x:Name="GutterPitchProbe"
                        MaxWidth="1"
                        MinWidth="0"
                        MinHeight="0"
                        UseLayoutRounding="False"
                        Opacity="0"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Padding="0"
                        BorderThickness="0"
                        AcceptsReturn="True"
                        FontSize="20"
                        TextWrapping="NoWrap"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <!-- 行情報欄（開始→終了時刻・横幅。エディタとスクロール同期、行高さは実測。
                         クリックで行選択、右クリックで行操作メニュー） -->
                    <ScrollViewer
                        x:Name="InsertGutterScroll"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled"
                        IsTabStop="False"
                        PointerWheelChanged="OnGutterWheel">
                        <StackPanel x:Name="InsertGutterStack" Margin="0,7,0,0" UseLayoutRounding="False" />
                    </ScrollViewer>
                    <TextBox
                        x:Name="InsertEditor"
                        Grid.Column="1"
                        Padding="10,6,6,6"
                        AcceptsReturn="True"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        FontSize="20"
                        TextWrapping="NoWrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        BeforeTextChanging="OnInsertEditorBeforeTextChanging"
                        TextChanged="OnInsertEditorTextChanged"
                        SelectionChanged="OnInsertEditorSelectionChanged"
                        PreviewKeyDown="OnInsertEditorPreviewKeyDown" />
                </Grid>
                <TextBlock
                    x:Name="InsertCursorInfo"
                    Grid.Row="3"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- 左と右のパネルの境（境の線。左右にドラッグ・← → キーで右のパネルの幅を変える。ダブルクリックで元の幅） -->
            <fs:ColumnResizeGrip
                x:Name="SideResizeGrip"
                Grid.Row="1"
                Grid.Column="1"
                Width="9"
                AutomationProperties.Name="右のパネルの幅"
                ToolTipService.ToolTip="ドラッグで右のパネルの幅を変えます（選んで ← → キーでも変えられます。ダブルクリックで元の幅に戻します）">
                <Grid Background="Transparent">
                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Rectangle
                        Width="4"
                        Height="48"
                        RadiusX="2"
                        RadiusY="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                </Grid>
            </fs:ColumnResizeGrip>

            <!-- 右パネル（行リストのとき）: フォント一覧（押すと選んだ文字・行に指定）とレイアウト設定 -->
            <Border
                Grid.Row="1"
                Grid.Column="2"
                x:Name="LineSideHost"
                Padding="8">
                <views:LineSidePanel x:Name="LineSide" />
            </Border>

            <!-- 右パネル（絵文字挿入ビューのとき）: @Emoji パレット -->
            <Grid
                Grid.Row="1"
                Grid.Column="2"
                x:Name="EmojiSidePanel"
                Visibility="Collapsed"
                Padding="8"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- F2 のキーは 表示 メニューにある（右パネルを隠すフォント設定ビューでも効くように） -->
                <ToggleButton
                    x:Name="EmojiModeToggle"
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    Content="絵文字挿入ビュー (F2)"
                    Checked="OnEmojiModeChanged"
                    Unchecked="OnEmojiModeChanged" />
                <Button Grid.Row="1" HorizontalAlignment="Stretch" Content="リスト編集..." Click="OnEmojiListClick" />

                <!-- 絵文字挿入設定のクイック調整（設定ダイアログと同じ項目を常時表示） -->
                <Grid Grid.Row="2" ColumnSpacing="6" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="表示秒数" FontSize="12" VerticalAlignment="Center"
                               ToolTipService.ToolTip="アイコン・＿・先行タグ（G）を直後の文字の何秒前から表示するか。新しく挿入する分に適用します（既存のアイコン・＿は 絵文字 > 絵文字タイムタグ再計算 で付け直せます。G の先行タグは再計算では変わりません）。書き出しでは、前のページの同じ段と重なる行だけ短くなることがあります（ふつうはワイプ前の表示時間まで。それより短い表示秒数は、前の行をワイプの最後まで見せるときだけ縮めます。書き出し画面の設定）" />
                    <Grid Grid.Column="1" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="QuickEmojiLeadBox" Minimum="0" Maximum="30" SmallChange="0.5"
                                   SpinButtonPlacementMode="Compact" ValueChanged="OnQuickEmojiLeadChanged" />
                        <ToggleButton Grid.Column="1" x:Name="QuickLeadZeroToggle" Content="0秒" Padding="8,5"
                                      Checked="OnQuickLeadZeroToggled" Unchecked="OnQuickLeadZeroToggled"
                                      ToolTipService.ToolTip="ワイプしない絵文字用に表示秒数を 0 にする（もう一度押すと元の秒数へ戻す）" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="連続タグ" FontSize="12" VerticalAlignment="Center"
                               ToolTipService.ToolTip="連続する絵文字のタグ付け方" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="QuickEmojiModeBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnQuickEmojiModeChanged">
                        <ComboBoxItem Content="各絵文字ごと" />
                        <ComboBoxItem Content="先頭と末尾のみ" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="＿文字" FontSize="12" VerticalAlignment="Center"
                               ToolTipService.ToolTip="プレースホルダ文字（挿入ビューの B キーで挿入）" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="QuickPlaceholderBox" MaxLength="4"
                             TextChanged="OnQuickPlaceholderChanged" />
                </Grid>

                <GridView
                    Grid.Row="3"
                    ItemsSource="{x:Bind ViewModel.EmojiSlots}"
                    IsItemClickEnabled="True"
                    ItemClick="OnEmojiSlotClick"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmojiSlotViewModel">
                            <Grid Width="60" Height="80" ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Bind KeyLabel}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <Image Grid.Row="1" Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" MaxHeight="40" />
                                <TextBlock Grid.Row="2" Text="{x:Bind ReplaceChar, Mode=OneWay}" HorizontalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- スロット外の曲内 @Emoji（クリックで挿入） -->
                <ListView
                    Grid.Row="4"
                    MaxHeight="140"
                    ItemsSource="{x:Bind ViewModel.UnslottedEmoji}"
                    IsItemClickEnabled="True"
                    ItemClick="OnUnslottedEmojiClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:EmojiEntry">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReplaceChar}" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ImageBefore}" />
                                <Button Grid.Column="1" Content="キーへ" FontSize="10" Padding="6,2" Click="OnPromoteEmojiClick" Tag="{x:Bind}" ToolTipService.ToolTip="キー付きスロットへ割り当てる" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 検証パネル -->
        <Expander
            Grid.Row="2"
            x:Name="IssuePanel"
            Header="チェック結果"
            MinHeight="32"
            Padding="8,4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            ExpandDirection="Up">
            <ListView
                x:Name="IssueList"
                MaxHeight="180"
                ItemsSource="{x:Bind ViewModel.Issues}"
                IsItemClickEnabled="True"
                ItemClick="OnIssueClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="val:ValidationIssue">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Message}" TextWrapping="Wrap" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <!-- フォント設定ビュー（F3。メイン（メディア再生を含む）・チェック結果の領域に重ねる）。
             中身の FontSettingsView は初めて開くときにコードで作る（MainWindow.Views.cs の EnsureFontView。
             ウィンドウの XAML では x:Load="False" の要素を FindName で作れず、x:Bind の x:Load はビルドできないため） -->
        <Border
            x:Name="FontViewHost"
            Grid.Row="1"
            Grid.RowSpan="2"
            Visibility="Collapsed" />

        <!-- ステータスバー（右端は MCP の接続と今のビュー） -->
        <Border Grid.Row="3" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel>
                <!-- 設定ファイルを読み込めなかったときの警告。ほかの表示で上書きされないよう、起動中ずっと出しておく -->
                <InfoBar x:Name="SettingsLoadFailedBar" Severity="Warning" IsClosable="False" Visibility="Collapsed" Margin="0,0,0,4" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusBarText" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" />
                    <!-- MCP（Claude などからの操作）の待ち受け・接続の印（MainWindow.Mcp.cs） -->
                    <TextBlock
                        x:Name="McpStatusText"
                        Grid.Column="1"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="ViewModeText"
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.ViewModeLabel, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
