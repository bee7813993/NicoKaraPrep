<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    Identity の Name / Publisher は Partner Center でアプリ名を予約すると確定する値。
    「アプリ管理 > Product identity」に表示される Package/Identity/Name と
    Package/Identity/Publisher をここに転記する（Visual Studio の
    [発行 > アプリケーションを Store と関連付ける] を使えば自動で書き換わる）。
    Version の第 4 セグメントは Store 予約のため 0 固定。
  -->
  <Identity
    Name="bee7813993.NicoKaraPrep"
    Publisher="CN=00000000-0000-0000-0000-000000000000"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>NicoKaraPrep</DisplayName>
    <PublisherDisplayName>bee7813993</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="NicoKaraPrep"
        Description="RhythmicaLyrics で作成したタイムタグ付き歌詞を、ニコカラメーカー3 に読み込ませるために加工するツール"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- 通信しないローカルアプリのため internetClient は宣言しない
       （プライバシーポリシー URL 不要のまま提出できる） -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
