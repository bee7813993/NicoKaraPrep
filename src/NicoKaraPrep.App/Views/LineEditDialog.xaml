<ContentDialog
    x:Class="NicoKaraPrep.App.Views.LineEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views"
    Title="行の編集"
    PrimaryButtonText="適用"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <!-- 絵文字挿入ビューの行の編集（行のダブルクリック・簡易行エディタの「行の編集...」）。歌詞（タイムタグ付き）と表示開始・終了をまとめて直す -->
    <StackPanel Width="480" Spacing="10">
        <TextBox
            x:Name="RawBox"
            Header="歌詞（タイムタグ付き。テキスト編集モードの書き方）"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            AcceptsReturn="False"
            IsSpellCheckEnabled="False"
            AutomationProperties.Name="行の歌詞（タイムタグ付き）" />
        <TextBlock x:Name="SungText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="BeginBox" local:PlaceholderPrefill.IsEnabled="True" Header="表示開始" Width="130" FontFamily="Consolas" AutomationProperties.Name="表示開始" />
            <TextBox x:Name="EndBox" local:PlaceholderPrefill.IsEnabled="True" Header="表示終了" Width="130" FontFamily="Consolas" AutomationProperties.Name="表示終了" />
            <Button
                x:Name="ResetButton"
                VerticalAlignment="Bottom"
                Content="自動に戻す"
                Click="OnResetClick"
                ToolTipService.ToolTip="手で指定した表示時刻と、読み込んだ値・自動調整の値を外して、自動の計算に戻します" />
        </StackPanel>
        <TextBlock
            x:Name="TimeNoteText"
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="表示開始・終了は mm:ss:cc（例: 01:14:00）で入れると、手で指定した値になります（行リストの行設定と同じ）。空欄なら自動で、薄字が今の表示時刻です（欄に入ると今の表示時刻が入るので、そこから直せます。変えなければ自動のまま）。" />
        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
