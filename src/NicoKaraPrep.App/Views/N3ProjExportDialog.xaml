<ContentDialog
    x:Class="NicoKaraPrep.App.Views.N3ProjExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views"
    Title="ニコカラメーカー3 プロジェクトを書き出し"
    PrimaryButtonText="書き出し..."
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="640">
        <StackPanel Spacing="10" MinWidth="620">

            <TextBlock
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="歌詞（タブごとに lrc）と .n3proj を同じフォルダへ書き出します。行の表示時刻・フォント・レイアウトは設定済みの状態になるので、ニコカラメーカー3 では開いてプレビュー／出力するだけです。行ごとの表示時刻やフォントは、行を選択して画面下の「ニコカラメーカー用の行設定」で変えられます。" />

            <TextBlock Text="ベースにする既存プロジェクト（フォント設定・レイアウト・タイトル・出力設定を引き継ぐ）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BasePathBox" PlaceholderText="（指定なし: 標準設定で生成）" IsReadOnly="True" />
                <Button Grid.Column="1" Content="参照..." Click="OnBrowseBaseClick" />
                <Button Grid.Column="2" Content="クリア" Click="OnClearBaseClick" />
            </Grid>
            <TextBlock x:Name="BaseInfoText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectNameBox" Header="プロジェクト名（ニコカラメーカーの設定名）" />
                <ComboBox Grid.Column="1" x:Name="DefaultFontBox" Header="行の既定フォント設定（パート記号が出るまで）" IsEditable="True" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock x:Name="MediaText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <CheckBox x:Name="MergeFontsCheck" Content="NicoKaraPrep のフォント設定をベースへ反映する（同名は上書き、無い名前は追加）" />
            <CheckBox x:Name="MergeLayoutsCheck" Content="NicoKaraPrep で編集したレイアウト設定をベースへ反映する（同名は上書き、無い名前は追加）" />

            <TextBlock Text="行の表示時刻（ニコカラメーカーの「自動で表示開始時刻・表示終了時刻を設定」と同じ意味）" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="LeadBox" Header="ワイプ前（秒）" Minimum="0" Maximum="30" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                <NumberBox Grid.Column="1" x:Name="TailBox" Header="ワイプ後（秒）" Minimum="0" Maximum="30" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                <NumberBox Grid.Column="2" x:Name="IntervalBox" Header="表示間隔（秒）" Minimum="0" Maximum="30" SmallChange="0.1" SpinButtonPlacementMode="Compact" ToolTipService.ToolTip="ページ区切りと段落区切り（間奏など）を分ける間隔" />
                <NumberBox Grid.Column="3" x:Name="ProtectBox" Header="最短表示後（秒、0=自動）" Minimum="0" Maximum="30" SmallChange="0.1" SpinButtonPlacementMode="Compact" ToolTipService.ToolTip="次のページと重なるとき、前の行を最終タグの何秒後まで短縮してよいか（0 = ワイプ前後の小さい方の半分）" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox x:Name="TopLongCheck" Content="上段の行をページの最後まで表示する（上段歌詞を長めに表示）" MinWidth="0" />
                <Button x:Name="ImportNkm3Button" Content="ニコカラメーカーの設定値を取り込む" FontSize="12" Padding="8,3" Click="OnImportNkm3Click" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock Text="歌詞設定タブ" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
            <Grid ColumnSpacing="6" Padding="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="タブ（歌詞ファイル）" FontSize="12" />
                <TextBlock Grid.Column="1" Text="行数" FontSize="12" />
                <TextBlock Grid.Column="2" Text="レイアウト" FontSize="12" />
                <TextBlock Grid.Column="3" Text="表示時刻の調整" FontSize="12" />
            </Grid>
            <ItemsControl x:Name="TabList" ItemsSource="{x:Bind Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:N3TabRow">
                        <Grid ColumnSpacing="6" Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind LineCountText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox Grid.Column="2" ItemsSource="{x:Bind LayoutChoices}" SelectedItem="{x:Bind LayoutChoice, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="3" SelectedIndex="{x:Bind TopLongIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="全体設定に従う" />
                                <ComboBoxItem Content="上段を短めに" />
                                <ComboBoxItem Content="上段を長めに" />
                            </ComboBox>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
