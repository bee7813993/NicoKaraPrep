<ContentDialog
    x:Class="NicoKaraPrep.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="設定"
    PrimaryButtonText="OK"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="12" MinWidth="420">

            <TextBlock Text="ページ衝突チェック" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="PageModeBox" Header="ページ区切り" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="空行で区切る（ニコカラメーカーの基本）" />
                <ComboBoxItem Content="固定行数でページ化" />
            </ComboBox>
            <NumberBox x:Name="FixedLineCountBox" Header="固定行数モードの行数" Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline" />
            <NumberBox x:Name="LeadBox" Header="行の表示開始（先頭タグの何秒前）" Minimum="0" Maximum="30" SmallChange="0.5" SpinButtonPlacementMode="Inline" />
            <NumberBox x:Name="TailBox" Header="行の表示終了（最終タグの何秒後）" Minimum="0" Maximum="30" SmallChange="0.5" SpinButtonPlacementMode="Inline" />
            <ComboBox x:Name="AlignBox" Header="ページ間で比較する行の対応付け" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="上から数えて同じ行番号同士（1行目↔1行目、2行目↔2行目）" />
                <ComboBoxItem Content="下から数えて同じ位置同士" />
            </ComboBox>
            <NumberBox x:Name="ThresholdBox" Header="エラーとする重なり秒数（以下は警告）" Minimum="0" Maximum="30" SmallChange="0.5" SpinButtonPlacementMode="Inline" />

            <TextBlock Text="横幅チェック" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <NumberBox x:Name="ScreenWidthBox" Header="画面（動画）の横幅 px" Minimum="320" Maximum="7680" SpinButtonPlacementMode="Inline" />
            <ComboBox x:Name="FontFamilyBox" Header="字幕フォント" IsEditable="True" HorizontalAlignment="Stretch" />
            <NumberBox x:Name="FontSizeBox" Header="フォントサイズ px" Minimum="8" Maximum="400" SpinButtonPlacementMode="Inline" />
            <NumberBox x:Name="EdgeSizeBox" Header="縁取りサイズ px（片側。@Emoji プレビューのアイコン縦位置に反映）" Minimum="0" Maximum="100" SmallChange="1" SpinButtonPlacementMode="Inline" />
            <CheckBox x:Name="BoldBox" Content="太字" />
            <NumberBox x:Name="MarginBox" Header="左右マージン（片側 %）" Minimum="0" Maximum="40" SmallChange="1" SpinButtonPlacementMode="Inline" />

            <TextBlock Text="絵文字挿入" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <NumberBox x:Name="EmojiLeadBox" Header="絵文字の表示秒数（直後の文字の何秒前から）" Minimum="0" Maximum="30" SmallChange="0.5" SpinButtonPlacementMode="Inline" />
            <ComboBox x:Name="EmojiModeBox" Header="連続する絵文字のタグ付け" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="各絵文字それぞれにタグを付ける（デフォルト）" />
                <ComboBoxItem Content="ブロックの先頭と末尾だけに付ける" />
            </ComboBox>
            <TextBox x:Name="PlaceholderBox" Header="プレースホルダ文字（挿入ビューの Space キーで挿入。アイコン同等のタイムタグ付き）" MaxLength="4" />

            <TextBlock Text="メディア再生" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <NumberBox x:Name="SeekSecondsBox" Header="Z / X（Ctrl+←/→）でシークする秒数" Minimum="0.5" Maximum="60" SmallChange="0.5" SpinButtonPlacementMode="Inline" />

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
