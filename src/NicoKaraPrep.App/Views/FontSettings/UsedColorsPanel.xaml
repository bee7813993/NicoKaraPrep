<UserControl
    x:Class="NicoKaraPrep.App.Views.FontSettings.UsedColorsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="PaletteTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- 見本のボタン（押したときなどに背景の色が変わっても、中の見本の色はそのまま） -->
        <Style x:Key="SwatchButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <!-- 使っている色の一覧: 役割（メイン色・ベース色など）ごとの色と、使っている画像。押すと編集中の箇所をその色・画像にする -->
    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasPalette, Mode=OneWay}">
        <TextBlock
            Text="使っている色"
            Style="{StaticResource PaletteTitle}"
            ToolTipService.ToolTip="アプリ共通・この曲専用のフォント設定で使っている色です。押すと、編集中の箇所をその色にします（同じ色は 1 つにまとめ、ミルフィーユ・グラデーションの色は入れていません）" />
        <ScrollViewer x:Name="PaletteScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="8" Padding="0,0,14,0">
                <ItemsRepeater x:Name="GroupsRepeater" ItemsSource="{x:Bind ViewModel.PaletteGroups}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteGroupItem">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontSize="12" />
                                <ItemsRepeater ItemsSource="{x:Bind Colors}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="26" MinItemHeight="26" MinRowSpacing="4" MinColumnSpacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaletteColorItem">
                                            <Button
                                                Width="26"
                                                Height="26"
                                                Style="{StaticResource SwatchButton}"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                ToolTipService.ToolTip="{x:Bind ToolTip}"
                                                Click="OnColorClick">
                                                <Border
                                                    CornerRadius="3"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    Background="{x:Bind Swatch}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasPaletteImages, Mode=OneWay}">
                    <TextBlock Text="画像" FontSize="12" />
                    <ItemsRepeater x:Name="ImagesRepeater" ItemsSource="{x:Bind ViewModel.PaletteImages}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="40" MinItemHeight="30" MinRowSpacing="4" MinColumnSpacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteImageItem">
                                <Button
                                    Width="40"
                                    Height="30"
                                    Style="{StaticResource SwatchButton}"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    ToolTipService.ToolTip="{x:Bind ToolTip}"
                                    Click="OnImageClick">
                                    <Border
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="{x:Bind Swatch}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
