<UserControl
    x:Class="NicoKaraPrep.App.Views.FontSettings.BrushEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views.FontSettings"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="SmallNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- 配色 1 箇所の編集欄（塗りの種類・マーカー・画像・色）。ColorPicker はこの 1 つだけで、単色の色かマーカーの色を編集する -->
    <StackPanel Spacing="10">
        <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <RadioButtons
            x:Name="TypeButtons"
            Header="塗りの種類"
            MaxColumns="2"
            ItemsSource="{x:Bind ViewModel.TypeChoices}"
            SelectedIndex="{x:Bind ViewModel.BrushType, Mode=TwoWay}" />

        <!-- グラデーション・ミルフィーユのマーカー -->
        <StackPanel x:Name="StopsPanel" Spacing="6" Visibility="{x:Bind ViewModel.IsStops, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.StopsNote, Mode=OneWay}" Style="{StaticResource SmallNote}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="StopStrip"
                    Width="40"
                    Height="200"
                    VerticalAlignment="Top"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{x:Bind ViewModel.StripBrush, Mode=OneWay}"
                    ToolTipService.ToolTip="縦方向の見本（上端 = 0%）" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <Grid ColumnSpacing="6" Padding="12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="位置 %" Style="{StaticResource SmallNote}" />
                        <TextBlock Grid.Column="2" Text="色" Style="{StaticResource SmallNote}" />
                        <TextBlock Grid.Column="3" Text="不透明度 %" Style="{StaticResource SmallNote}" />
                    </Grid>
                    <ListView
                        x:Name="StopList"
                        MaxHeight="260"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind ViewModel.Stops}"
                        SelectedItem="{x:Bind ViewModel.SelectedStop, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GradientStopViewModel">
                                <Grid ColumnSpacing="6" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Value="{x:Bind PositionValue, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Hidden" ToolTipService.ToolTip="位置 %（0 = 上端）" />
                                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind Swatch, Mode=OneWay}" />
                                    <TextBox Grid.Column="2" Text="{x:Bind HexText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" MaxLength="7" ToolTipService.ToolTip="色（16 進 RRGGBB）。行を選ぶと下の ColorPicker でも変えられます" />
                                    <NumberBox Grid.Column="3" Value="{x:Bind AlphaValue, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Hidden" ToolTipService.ToolTip="不透明度 %" />
                                    <Button Grid.Column="4" Padding="6,4" IsEnabled="{x:Bind CanDelete}" ToolTipService.ToolTip="{x:Bind DeleteToolTip}" Click="OnDeleteStopClick">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- マーカーを足す（一覧の操作） -->
                    <Button x:Name="AddStopButton" Click="OnAddStopClick" ToolTipService.ToolTip="選んだマーカーと次のマーカーの間（選んでいなければいちばん広い間）に足します">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="マーカーを追加" />
                        </StackPanel>
                    </Button>
                    <!-- マーカーの並べ方（どちらも位置だけを並べ直す同じ種類の操作なので、1 つのまとまりに横に並べる。% は端を広くするときだけ使う） -->
                    <Border
                        x:Name="ArrangeGroup"
                        HorizontalAlignment="Left"
                        Padding="10,8"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="マーカーの並べ方（位置だけを並べ直します。色の並びはそのまま）" Style="{StaticResource SmallNote}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="DistributeStopsButton"
                                    MinWidth="108"
                                    Content="均等に配置"
                                    Click="OnDistributeStopsClick"
                                    ToolTipService.ToolTip="帯をすべて同じ幅にします" />
                                <Button
                                    x:Name="WidenEndsButton"
                                    MinWidth="108"
                                    Content="端を広く配置"
                                    Click="OnWidenEndsClick"
                                    ToolTipService.ToolTip="文字の上下の端は面積が小さいので、端の帯ほど広くします（右の % だけ、端の帯を中央の帯より広く。組み合わせのフォント設定と同じ並べ方）" />
                                <TextBlock Text="端の広さ" VerticalAlignment="Center" Style="{StaticResource SmallNote}" />
                                <NumberBox
                                    x:Name="EndWidenBox"
                                    Width="96"
                                    Minimum="0"
                                    Maximum="200"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.EndWidenValue, Mode=TwoWay}"
                                    AutomationProperties.Name="端の帯の広さ %"
                                    ToolTipService.ToolTip="「端を広く配置」で、端の帯を中央の帯より何 % 広くするか（0 で等分）" />
                                <TextBlock Text="%" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 画像 -->
        <StackPanel x:Name="BitmapPanel" Spacing="6" Visibility="{x:Bind ViewModel.IsBitmap, Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BitmapPathBox" Header="画像ファイル" Text="{x:Bind ViewModel.BitmapPath, Mode=TwoWay}" />
                <Button Grid.Column="1" Content="参照..." VerticalAlignment="Bottom" Click="OnBrowseBitmapClick" />
            </Grid>
            <NumberBox
                x:Name="BitmapScaleBox"
                Header="拡大率 %"
                Width="140"
                HorizontalAlignment="Left"
                Minimum="1"
                Maximum="1000"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.BitmapScaleValue, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.BitmapNote, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <!-- 画像の見本と、その右に使っている色・画像の一覧（色を押すと単色に、画像を押すとその画像にする） -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="160"
                    Height="96"
                    VerticalAlignment="Top"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{x:Bind ViewModel.StripBrush, Mode=OneWay}" />
                <local:UsedColorsPanel x:Name="BitmapPalette" Grid.Column="1" VerticalAlignment="Top" />
            </Grid>
        </StackPanel>

        <!-- 色（単色の色、または選んだマーカーの色） -->
        <TextBlock Text="{x:Bind ViewModel.ColorTargetText, Mode=OneWay}" Style="{StaticResource SmallNote}" />
        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsColorEditorVisible, Mode=OneWay}">
            <!-- ColorPicker と、その右の空いた所に使っている色の一覧 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ColorPicker
                    x:Name="Picker"
                    Color="{x:Bind ViewModel.PickerColor, Mode=TwoWay}"
                    ColorSpectrumShape="Box"
                    IsAlphaEnabled="True"
                    IsAlphaSliderVisible="True"
                    IsAlphaTextInputVisible="False"
                    IsColorChannelTextInputVisible="False"
                    IsHexInputVisible="False"
                    IsMoreButtonVisible="False"
                    IsColorPreviewVisible="True" />
                <local:UsedColorsPanel x:Name="PickerPalette" Grid.Column="1" VerticalAlignment="Top" />
            </Grid>
            <StackPanel x:Name="HexRow" Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="HexBox"
                    Header="16 進 (RRGGBB)"
                    Width="120"
                    MaxLength="7"
                    FontFamily="Consolas"
                    PlaceholderText="未指定"
                    Text="{x:Bind ViewModel.HexText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <NumberBox
                    x:Name="AlphaBox"
                    Header="不透明度 %"
                    Width="120"
                    Minimum="0"
                    Maximum="100"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.AlphaValue, Mode=TwoWay}" />
                <Button
                    x:Name="EyedropperButton"
                    VerticalAlignment="Bottom"
                    Click="OnEyedropperClick"
                    AutomationProperties.Name="スポイト（画面から色を拾う）"
                    ToolTipService.ToolTip="スポイト: 画面のどこからでも色を拾います（押したときの画面を止めて出すので、動画の 1 コマからも拾えます）。&#x0a;クリック・Enter で決める、Esc・右クリックでやめる、矢印キーで 1 px ずつ動かす。&#x0a;Tab でにこぷれっぷの窓を隠して、後ろの窓から拾えます。不透明度は今の値のままです">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEF3C;" FontSize="14" />
                        <TextBlock Text="スポイト" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ClearColorButton"
                    VerticalAlignment="Bottom"
                    Content="未指定に戻す"
                    Visibility="{x:Bind ViewModel.IsSolid, Mode=OneWay}"
                    ToolTipService.ToolTip="色を指定しない（書き出し時はベースの n3proj の色、ベースが無ければ既定の色）"
                    Click="OnClearColorClick" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
