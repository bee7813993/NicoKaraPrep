<ContentDialog
    x:Class="NicoKaraPrep.App.Views.FontSettings.ColorPatternDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views.FontSettings"
    Title="配色パターン"
    PrimaryButtonText="保存"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="DialogNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <!-- 左 = パターンの一覧（標準・自作）、右 = 選んだパターンの名前・役割・8 箇所の割り当て -->
    <Grid Width="860" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="PatternList"
                Height="380"
                SelectionMode="Single"
                ItemsSource="{x:Bind Rows}"
                SelectionChanged="OnPatternSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ColorPatternRow">
                        <TextBlock Text="{x:Bind Display, Mode=OneWay}" TextTrimming="CharacterEllipsis" Padding="0,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="AddPatternButton" Content="追加" Click="OnAddClick" />
                <Button x:Name="DuplicatePatternButton" Content="複製" Click="OnDuplicateClick" />
                <Button x:Name="DeletePatternButton" Content="削除" Click="OnDeleteClick" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock x:Name="ReadOnlyNote" Style="{StaticResource DialogNote}" Text="標準のパターンは変えられません。「複製」すると、写しを自由に変えられます" />
            <TextBox x:Name="PatternNameBox" Header="名前" TextChanged="OnNameChanged" />
            <TextBlock Style="{StaticResource DialogNote}" Text="役割の名前（同じ役割の箇所は同じ色にそろえます。空欄の役割は使いません）" />
            <Grid ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="RoleABox" Header="役割 A" TextChanged="OnRoleNameChanged" />
                <TextBox x:Name="RoleBBox" Grid.Column="1" Header="役割 B" TextChanged="OnRoleNameChanged" />
                <TextBox x:Name="RoleCBox" Grid.Row="1" Header="役割 C" TextChanged="OnRoleNameChanged" />
                <TextBox x:Name="RoleDBox" Grid.Row="1" Grid.Column="1" Header="役割 D" TextChanged="OnRoleNameChanged" />
            </Grid>
            <TextBlock Style="{StaticResource DialogNote}" Text="箇所ごとの役割（「個別」の箇所はパターンに縛られず、1 箇所ずつ指定します）" />
            <!-- 見出しの行と、ワイプ後・ワイプ前の 2 行（中の選択欄はコードで作る） -->
            <Grid x:Name="SlotGrid" ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            </Grid>
            <TextBlock x:Name="SummaryText" Style="{StaticResource DialogNote}" />
            <ComboBox
                x:Name="DefaultPatternBox"
                Header="新しいフォント設定に使うパターン"
                MinWidth="320"
                ToolTipService.ToolTip="「追加」で作るフォント設定の色を、このパターンの形にそろえます" />
        </StackPanel>
    </Grid>
</ContentDialog>
