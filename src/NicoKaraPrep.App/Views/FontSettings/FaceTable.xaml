<UserControl
    x:Class="NicoKaraPrep.App.Views.FontSettings.FaceTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="FaceHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </UserControl.Resources>

    <!-- 文字種別フォント 6 行の表。空欄は継承（PlaceholderText に継承した値） -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
        <StackPanel Spacing="2" MinWidth="860">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="124" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="種別" Style="{StaticResource FaceHeader}" />
                <TextBlock Grid.Column="1" Text="フォント名" Style="{StaticResource FaceHeader}" />
                <TextBlock Grid.Column="2" Text="フェイス" Style="{StaticResource FaceHeader}" />
                <TextBlock Grid.Column="3" Text="サイズ px" Style="{StaticResource FaceHeader}" />
                <TextBlock Grid.Column="4" Text="横倍率 %" Style="{StaticResource FaceHeader}" />
                <TextBlock Grid.Column="5" Text="縁 px" Style="{StaticResource FaceHeader}" />
                <TextBlock Grid.Column="6" Text="縁 2" Style="{StaticResource FaceHeader}" />
                <TextBlock Grid.Column="7" Text="縁 2 幅 px" Style="{StaticResource FaceHeader}" />
            </Grid>
            <ItemsControl x:Name="FaceRows" ItemsSource="{x:Bind ViewModel.Faces}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FaceRowViewModel">
                        <Grid ColumnSpacing="6" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="1"
                                IsEditable="True"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                ItemsSource="{x:Bind FontChoices}"
                                Tag="font"
                                Loaded="OnNameComboLoaded"
                                PlaceholderText="{x:Bind FontNamePlaceholder, Mode=OneWay}"
                                SelectionChanged="OnFontSelectionChanged"
                                TextSubmitted="OnFontTextSubmitted" />
                            <ComboBox
                                Grid.Column="2"
                                IsEditable="True"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                ItemsSource="{x:Bind FaceChoices}"
                                Tag="face"
                                Loaded="OnNameComboLoaded"
                                PlaceholderText="{x:Bind FaceNamePlaceholder, Mode=OneWay}"
                                SelectionChanged="OnFaceSelectionChanged"
                                TextSubmitted="OnFaceTextSubmitted" />
                            <NumberBox Grid.Column="3" FontSize="12" SpinButtonPlacementMode="Hidden" Value="{x:Bind SizeValue, Mode=TwoWay}" PlaceholderText="{x:Bind SizePlaceholder, Mode=OneWay}" />
                            <NumberBox Grid.Column="4" FontSize="12" SpinButtonPlacementMode="Hidden" Value="{x:Bind XScaleValue, Mode=TwoWay}" PlaceholderText="{x:Bind XScalePlaceholder, Mode=OneWay}" />
                            <NumberBox Grid.Column="5" FontSize="12" SpinButtonPlacementMode="Hidden" Value="{x:Bind EdgeValue, Mode=TwoWay}" PlaceholderText="{x:Bind EdgePlaceholder, Mode=OneWay}" />
                            <ComboBox
                                Grid.Column="6"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                ItemsSource="{x:Bind Edge2Choices}"
                                SelectedIndex="{x:Bind Edge2Index, Mode=TwoWay}"
                                PlaceholderText="{x:Bind Edge2Placeholder, Mode=OneWay}" />
                            <NumberBox Grid.Column="7" FontSize="12" SpinButtonPlacementMode="Hidden" Value="{x:Bind Edge2Value, Mode=TwoWay}" PlaceholderText="{x:Bind Edge2WidthPlaceholder, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Margin="0,6,0,0"
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="空欄は継承です（薄字が継承した値）。歌詞／かな・英数とルビ／漢字は歌詞／漢字を、ルビ／かな・英数はルビ／漢字を継承します。ルビ／漢字のサイズ・縁・縁 2 幅の空欄は、NicoKaraPrep では歌詞の半分として書き出します（ニコカラメーカー3 の「継承」は歌詞と同じ大きさです）。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
