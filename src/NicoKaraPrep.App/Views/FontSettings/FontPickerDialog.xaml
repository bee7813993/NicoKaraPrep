<ContentDialog
    x:Class="NicoKaraPrep.App.Views.FontSettings.FontPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views.FontSettings"
    Title="フォントを選ぶ"
    PrimaryButtonText="このフォントにする"
    SecondaryButtonText="継承に戻す"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <!-- 左 = フォント（ファミリー）の見本の一覧、右 = 選んだフォントのフェイス（太さ・斜体）の見本の一覧 -->
    <Grid Width="940" Height="560" RowSpacing="8" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FontSearchBox"
                Header="検索"
                PlaceholderText="フォント名（英語名でも可）。無いフォント名もそのまま使えます"
                TextChanged="OnSearchChanged" />
            <TextBox
                x:Name="FontSampleBox"
                Grid.Column="1"
                Header="見本の文字"
                TextChanged="OnSampleChanged" />
            <CheckBox
                x:Name="JapaneseOnlyBox"
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Content="日本語のあるフォントだけ"
                Checked="OnFilterChanged"
                Unchecked="OnFilterChanged" />
        </Grid>

        <Grid Grid.Row="1">
            <GridView
                x:Name="FamilyGrid"
                SelectionMode="Single"
                AutomationProperties.Name="フォントの一覧"
                SelectionChanged="OnFamilySelectionChanged"
                DoubleTapped="OnFamilyDoubleTapped">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:FontFamilyItem">
                        <Grid Width="204" Height="80" Padding="8,4" RowSpacing="2" ToolTipService.ToolTip="{x:Bind ToolTip}" AutomationProperties.Name="{x:Bind Name}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="{x:Bind Sample, Mode=OneWay}"
                                FontFamily="{x:Bind PreviewFamily}"
                                FontWeight="{x:Bind PreviewWeight}"
                                FontStyle="{x:Bind PreviewStyle}"
                                FontStretch="{x:Bind PreviewStretch}"
                                FontSize="26"
                                VerticalAlignment="Center"
                                TextWrapping="NoWrap"
                                TextTrimming="Clip" />
                            <Grid Grid.Row="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Badge}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="True" />
                <TextBlock Text="フォントの一覧を読み込み中…" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="フェイス（太さ・斜体）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView
                x:Name="FaceList"
                Grid.Row="1"
                SelectionMode="Single"
                AutomationProperties.Name="フェイスの一覧"
                SelectionChanged="OnFaceSelectionChanged"
                DoubleTapped="OnFaceDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FontFaceItem">
                        <StackPanel Padding="0,4" AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <TextBlock
                                Text="{x:Bind Sample, Mode=OneWay}"
                                FontFamily="{x:Bind PreviewFamily}"
                                FontWeight="{x:Bind Weight}"
                                FontStyle="{x:Bind Style}"
                                FontStretch="{x:Bind Stretch}"
                                FontSize="22"
                                TextWrapping="NoWrap"
                                TextTrimming="Clip" />
                            <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
            <TextBlock x:Name="SelectionText" TextWrapping="Wrap" />
            <TextBlock x:Name="InheritText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</ContentDialog>
