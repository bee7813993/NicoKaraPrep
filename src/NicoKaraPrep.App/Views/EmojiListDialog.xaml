<ContentDialog
    x:Class="NicoKaraPrep.App.Views.EmojiListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views"
    Title="@Emoji タグリスト編集"
    PrimaryButtonText="OK"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <Grid RowSpacing="8" MinWidth="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- プレビュー＋パラメータ調整（選択行を現在のフォント設定で表示） -->
        <Border
            Grid.Row="0"
            Padding="12,8"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel x:Name="PreviewHost" Orientation="Horizontal" VerticalAlignment="Bottom" MinHeight="56" />
                    <TextBlock x:Name="PreviewCaption" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="行を選択するとプレビューを見ながら調整できます" />
                </StackPanel>

                <!-- 選択行のパラメータ調整（動かすとオプション文字列を自動生成） -->
                <Grid Grid.Column="1" x:Name="ParamPanel" IsEnabled="False" RowSpacing="2" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>

                    <Slider
                        x:Name="ZoomSlider"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Header="Zoom（アイコンの大きさ %）"
                        Minimum="10"
                        Maximum="500"
                        StepFrequency="5"
                        Value="100"
                        ValueChanged="OnZoomSliderChanged" />
                    <NumberBox
                        x:Name="ZoomBox"
                        Grid.Row="0"
                        Grid.Column="2"
                        Header="Zoom"
                        Minimum="10"
                        Maximum="500"
                        SmallChange="5"
                        Value="100"
                        VerticalAlignment="Bottom"
                        ValueChanged="OnParamChanged" />

                    <NumberBox x:Name="MarginLeftBox" Grid.Row="1" Grid.Column="0" Header="左余白 px" Minimum="-500" Maximum="500" SmallChange="5" Value="0" ValueChanged="OnParamChanged" />
                    <NumberBox x:Name="MarginRightBox" Grid.Row="1" Grid.Column="1" Header="右余白 px" Minimum="-500" Maximum="500" SmallChange="5" Value="0" ValueChanged="OnParamChanged" />
                    <NumberBox x:Name="MarginBottomBox" Grid.Row="1" Grid.Column="2" Header="下余白 px" Minimum="-500" Maximum="500" SmallChange="5" Value="0" ValueChanged="OnParamChanged" />

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <CheckBox x:Name="FixCheck" Content="Fix（元サイズ維持）" MinWidth="0" Click="OnParamCheckChanged" />
                        <CheckBox x:Name="NoDecorCheck" Content="NoDecor（文字飾りなし）" MinWidth="0" Click="OnParamCheckChanged" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="1"
            TextWrapping="Wrap"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="上から20行にキー（1–0 / Q–P）が割り当てられます。21行目以降はパレットのリストからクリックで挿入できます。「曲専用」を付けた行はこの曲だけで有効、外すとアプリ共通に保存されます。" />

        <Grid Grid.Row="2" ColumnSpacing="6" Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="128" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="キー" FontSize="12" />
            <TextBlock Grid.Column="1" Text="文字" FontSize="12" />
            <TextBlock Grid.Column="2" Text="ワイプ前画像" FontSize="12" />
            <TextBlock Grid.Column="3" Text="ワイプ後画像（省略可）" FontSize="12" />
            <TextBlock Grid.Column="4" Text="オプション" FontSize="12" />
            <TextBlock Grid.Column="5" Text="曲専用" FontSize="12" />
            <TextBlock Grid.Column="6" Text="操作" FontSize="12" />
        </Grid>

        <ListView
            Grid.Row="3"
            x:Name="SlotList"
            MaxHeight="420"
            SelectionMode="Single"
            SelectionChanged="OnRowSelectionChanged"
            ItemsSource="{x:Bind Rows}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:EmojiSlotRow">
                    <Grid ColumnSpacing="6" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind KeyLabel, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{x:Bind ReplaceChar, Mode=TwoWay}" />
                        <Grid Grid.Column="2" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ImageBefore, Mode=TwoWay}" FontSize="12" />
                            <Button Grid.Column="1" Content="..." Click="OnBrowseBeforeClick" Tag="{x:Bind}" />
                        </Grid>
                        <Grid Grid.Column="3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ImageAfter, Mode=TwoWay}" FontSize="12" />
                            <Button Grid.Column="1" Content="..." Click="OnBrowseAfterClick" Tag="{x:Bind}" />
                        </Grid>
                        <TextBox Grid.Column="4" Text="{x:Bind Options, Mode=TwoWay}" PlaceholderText="Zoom=150,Fix" FontSize="12" />
                        <CheckBox Grid.Column="5" IsChecked="{x:Bind IsSongOverride, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2">
                            <Button Content="複" FontSize="11" Padding="6,2" MinWidth="0" Click="OnDuplicateRowClick" Tag="{x:Bind}" ToolTipService.ToolTip="この行を複製（画像だけ差し替える用途に）" />
                            <Button Content="↑" FontSize="11" Padding="6,2" MinWidth="0" Click="OnMoveUpClick" Tag="{x:Bind}" ToolTipService.ToolTip="上へ（キー割り当ても入れ替わります）" />
                            <Button Content="↓" FontSize="11" Padding="6,2" MinWidth="0" Click="OnMoveDownClick" Tag="{x:Bind}" ToolTipService.ToolTip="下へ" />
                            <Button Content="✕" FontSize="11" Padding="6,2" MinWidth="0" Click="OnDeleteRowClick" Tag="{x:Bind}" ToolTipService.ToolTip="この行を削除" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="4" Content="＋ 行を追加" Click="OnAddRowClick" HorizontalAlignment="Left" />
    </Grid>
</ContentDialog>
