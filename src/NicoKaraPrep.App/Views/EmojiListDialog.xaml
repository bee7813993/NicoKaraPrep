<ContentDialog
    x:Class="NicoKaraPrep.App.Views.EmojiListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views"
    Title="@Emoji タグリスト編集"
    PrimaryButtonText="OK"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <Grid RowSpacing="8" MinWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            TextWrapping="Wrap"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="スロットのキー（1–0 / Q–P）で歌詞に挿入できます。「曲専用」を付けたスロットはこの曲でのみ有効になり、外すとアプリ共通（グローバル）に保存されます。" />

        <Grid Grid.Row="1" ColumnSpacing="8" Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="キー" FontSize="12" />
            <TextBlock Grid.Column="1" Text="文字" FontSize="12" />
            <TextBlock Grid.Column="2" Text="ワイプ前画像" FontSize="12" />
            <TextBlock Grid.Column="3" Text="ワイプ後画像（省略可）" FontSize="12" />
            <TextBlock Grid.Column="4" Text="オプション" FontSize="12" />
            <TextBlock Grid.Column="5" Text="曲専用" FontSize="12" />
        </Grid>

        <ListView Grid.Row="2" x:Name="SlotList" MaxHeight="480" SelectionMode="None" ItemsSource="{x:Bind Rows}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:EmojiSlotRow">
                    <Grid ColumnSpacing="8" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind KeyLabel}" VerticalAlignment="Center" FontWeight="Bold" />
                        <TextBox Grid.Column="1" Text="{x:Bind ReplaceChar, Mode=TwoWay}" MaxLength="2" />
                        <Grid Grid.Column="2" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ImageBefore, Mode=TwoWay}" FontSize="12" />
                            <Button Grid.Column="1" Content="..." Click="OnBrowseBeforeClick" Tag="{x:Bind}" />
                        </Grid>
                        <Grid Grid.Column="3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ImageAfter, Mode=TwoWay}" FontSize="12" />
                            <Button Grid.Column="1" Content="..." Click="OnBrowseAfterClick" Tag="{x:Bind}" />
                        </Grid>
                        <TextBox Grid.Column="4" Text="{x:Bind Options, Mode=TwoWay}" PlaceholderText="Zoom=150%,Fix" FontSize="12" />
                        <CheckBox Grid.Column="5" IsChecked="{x:Bind IsSongOverride, Mode=TwoWay}" MinWidth="0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
