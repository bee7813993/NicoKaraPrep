<UserControl
    x:Class="NicoKaraPrep.App.Views.FontSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels"
    xmlns:fs="using:NicoKaraPrep.App.Views.FontSettings"
    KeyDown="OnKeyDown"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- フォント設定ビューの中の 元に戻す・やり直し（歌詞の 元に戻す とは別。文字の入力欄の中では入力欄が処理する） -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoInvoked" />
        <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoInvoked" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="PaneTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <!-- 配色の 1 箇所のボタン（色見本と箇所の名前。編集中の箇所は枠を強調） -->
        <DataTemplate x:Key="BrushCellTemplate" x:DataType="vm:BrushCellViewModel">
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Padding="3"
                Tag="{x:Bind Index}"
                AutomationProperties.Name="{x:Bind ToolTip, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                Click="OnBrushCellClick">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border MinHeight="30" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Grid>
                            <Border CornerRadius="2" Background="{x:Bind Swatch, Mode=OneWay}" />
                            <TextBlock Text="未指定" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsBlank, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind Label}" FontSize="12" />
                        <TextBlock Text="{x:Bind TypeText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.RowSpan="2" Margin="-3" CornerRadius="4" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 左の一覧の階層の節 1 つ（フォント設定は 1 行に色見本・名前・印・使用文字数、フォルダ・まとまりは記号・名前・中の数） -->
        <DataTemplate x:Key="FontTreeItemTemplate" x:DataType="vm:FontTreeItem">
            <Grid MinHeight="26">
                <Grid ColumnSpacing="6" Visibility="{x:Bind IsFont}" ToolTipService.ToolTip="{x:Bind Font.ToolTip, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Border Width="10" Height="20" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind Font.AfterBrush, Mode=OneWay}" />
                        <Border Width="10" Height="20" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind Font.BeforeBrush, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind Font.DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderThickness="1" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind Font.IsLinked, Mode=OneWay}">
                            <TextBlock Text="連動" FontSize="10" />
                        </Border>
                        <Border Style="{StaticResource Badge}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Visibility="{x:Bind Font.IsOverridden, Mode=OneWay}">
                            <TextBlock Text="曲で上書き" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind Font.UsageText, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind Font.HasUsage, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="6" Visibility="{x:Bind IsGroup}" ToolTipService.ToolTip="{x:Bind GroupToolTip, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 3 列: 左 = 一覧 / 中央 = 編集 / 右 = プレビュー・使用状況・検証 -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12,8,12,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左: 一覧（階層のツリー。検索・絞り込みの間は当てはまるものを平らに並べる） ================= -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="フォント設定" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <Button x:Name="BackButton" Grid.Column="1" Content="行リストへ戻る (Esc)" FontSize="12" Padding="8,3" Click="OnBackClick" />
            </Grid>
            <TextBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="名前・フォルダ名で検索"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTipService.ToolTip="名前か、上の階層（フォルダなど）の名前に含まれるものを平らに並べます。空にすると階層の表示に戻ります" />
            <ComboBox
                x:Name="FilterBox"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.FilterChoices}"
                SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                ToolTipService.ToolTip="絞り込み（未使用 = 開いている歌詞のどの文字にも適用されないもの）" />
            <InfoBar
                Grid.Row="3"
                Severity="Warning"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSongSaveNote, Mode=OneWay}"
                Message="{x:Bind ViewModel.SongSaveNote, Mode=OneWay}" />
            <TreeView
                x:Name="FontTree"
                Grid.Row="4"
                SelectionMode="Single"
                CanDragItems="True"
                CanReorderItems="True"
                AllowDrop="True"
                AutomationProperties.Name="フォント設定の階層"
                Visibility="{x:Bind ViewModel.IsTreeMode, Mode=OneWay}"
                SelectionChanged="OnFontTreeSelectionChanged"
                ItemInvoked="OnFontTreeItemInvoked"
                Expanding="OnFontTreeExpanding"
                Collapsed="OnFontTreeCollapsed"
                DragItemsStarting="OnFontTreeDragItemsStarting"
                DragItemsCompleted="OnFontTreeDragItemsCompleted">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="TreeViewNode">
                        <ContentControl
                            Content="{x:Bind Content}"
                            ContentTemplate="{StaticResource FontTreeItemTemplate}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False" />
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <ListView
                x:Name="FontList"
                Grid.Row="4"
                SelectionMode="Single"
                Visibility="{x:Bind ViewModel.IsFlatMode, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                SelectionChanged="OnFontListSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FontListItem">
                        <Grid ColumnSpacing="8" Padding="0,4" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Border Width="12" Height="30" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind AfterBrush, Mode=OneWay}" />
                                <Border Width="12" Height="30" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind BeforeBrush, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                    <Border Style="{StaticResource Badge}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsSong}">
                                        <TextBlock Text="曲" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderThickness="1" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsLinked, Mode=OneWay}">
                                        <TextBlock Text="連動" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind PathText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind HasPath, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind FaceText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="曲専用で上書き" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind IsOverridden, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind UsageText, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="4">
                <Button x:Name="AddButton" Padding="8,4" Click="OnAddClick" ToolTipService.ToolTip="フォント設定を追加（選んでいるフォルダの中・選んでいるフォント設定のすぐ後。この曲専用を選んでいれば曲専用に）">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="追加" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddFolderButton" Padding="8,4" Click="OnAddFolderClick" AutomationProperties.Name="フォルダを作る" ToolTipService.ToolTip="フォルダを作る（選んでいるフォルダの中・選んでいるフォント設定のすぐ後）。フォルダはにこぷれっぷの中での整理用で、書き出しには影響しません">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8F4;" FontSize="12" />
                        <TextBlock Text="フォルダ" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="DuplicateButton" Padding="8,4" Click="OnDuplicateClick" IsEnabled="{x:Bind ViewModel.CanDuplicate, Mode=OneWay}" ToolTipService.ToolTip="選んだフォント設定を複製">
                    <TextBlock Text="複製" FontSize="12" />
                </Button>
                <Button x:Name="DeleteButton" Padding="8,4" Click="OnDeleteClick" IsEnabled="{x:Bind ViewModel.CanDeleteSelection, Mode=OneWay}" AutomationProperties.Name="削除" ToolTipService.ToolTip="選んだフォント設定を削除（フォルダを選んでいれば、フォルダだけを削除して中身は 1 つ上の階層へ。Ctrl+Z で戻せます）">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="4">
                <Button x:Name="MoveUpButton" Padding="8,4" Click="OnMoveUpClick" IsEnabled="{x:Bind ViewModel.CanMoveUp, Mode=OneWay}" AutomationProperties.Name="上へ" ToolTipService.ToolTip="上へ（同じ階層の中で）">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button x:Name="MoveDownButton" Padding="8,4" Click="OnMoveDownClick" IsEnabled="{x:Bind ViewModel.CanMoveDown, Mode=OneWay}" AutomationProperties.Name="下へ" ToolTipService.ToolTip="下へ（同じ階層の中で）">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <Button x:Name="OutdentButton" Padding="8,4" Click="OnOutdentClick" IsEnabled="{x:Bind ViewModel.CanOutdent, Mode=OneWay}" AutomationProperties.Name="階層を上げる" ToolTipService.ToolTip="階層を上げる（入っているフォルダ・フォント設定の外へ出す）">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button x:Name="IndentButton" Padding="8,4" Click="OnIndentClick" IsEnabled="{x:Bind ViewModel.CanIndent, Mode=OneWay}" AutomationProperties.Name="階層を下げる" ToolTipService.ToolTip="階層を下げる（すぐ上のフォルダ・フォント設定の中へ入れる）">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
                <Button x:Name="MoveToButton" Padding="8,4" Click="OnMoveToClick" IsEnabled="{x:Bind ViewModel.CanMoveTo, Mode=OneWay}" ToolTipService.ToolTip="選んだフォント設定・フォルダを、別のフォルダやフォント設定の中へ移す（一覧の中のドラッグでも移せます）">
                    <TextBlock Text="移動..." FontSize="12" />
                </Button>
                <DropDownButton x:Name="ImportButton" Padding="8,4">
                    <TextBlock Text="取り込み" FontSize="12" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem x:Name="ImportN3ProjItem" Text="n3proj から..." Click="OnImportN3ProjClick" />
                            <MenuFlyoutItem x:Name="ImportTemplateItem" Text="ニコカラメーカー3 のテンプレートから..." Click="OnImportTemplateClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <TextBlock x:Name="ListSummaryText" Grid.Row="7" Text="{x:Bind ViewModel.ListSummary, Mode=OneWay}" Style="{StaticResource Note}" />
        </Grid>

        <!-- ================= 中央: 編集 ================= -->
        <Grid Grid.Column="1">
            <TextBlock
                x:Name="NoFontText"
                Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Style="{StaticResource Note}"
                Text="左の一覧でフォント設定かフォルダを選ぶか、「追加」で作ってください" />

            <!-- フォルダ・「この曲専用」のまとまりを選んだとき -->
            <ScrollViewer x:Name="FolderScroll" Visibility="{x:Bind ViewModel.HasFolder, Mode=OneWay}">
                <StackPanel Spacing="12" Padding="0,0,16,16">
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.FolderTitle, Mode=OneWay}" Style="{StaticResource SectionTitle}" />
                            <TextBox
                                x:Name="FolderNameBox"
                                Header="名前"
                                Width="360"
                                HorizontalAlignment="Left"
                                Text="{x:Bind ViewModel.FolderNameText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanEditFolder, Mode=OneWay}"
                                KeyDown="OnFolderNameKeyDown"
                                LostFocus="OnFolderNameLostFocus"
                                ToolTipService.ToolTip="フォルダの名前（にこぷれっぷの中での整理用で、書き出しには影響しません）。Enter で確定" />
                            <TextBlock x:Name="FolderSummaryText" Text="{x:Bind ViewModel.FolderSummary, Mode=OneWay}" Style="{StaticResource Note}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddInFolderButton" Content="この中にフォント設定を追加" Click="OnAddClick" />
                                <Button x:Name="AddSubFolderButton" Content="この中にフォルダを作る" Click="OnAddFolderClick" Visibility="{x:Bind ViewModel.CanEditFolder, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.CanEditFolder, Mode=OneWay}">
                                <Button x:Name="DeleteFolderButton" Content="フォルダを削除（中身は残す）" Click="OnDeleteFolderClick" ToolTipService.ToolTip="フォルダだけを削除し、中のフォント設定・フォルダは 1 つ上の階層へ移します（Ctrl+Z で戻せます）" />
                                <Button x:Name="DeleteFolderAllButton" Content="中身ごと削除..." Click="OnDeleteFolderAllClick" ToolTipService.ToolTip="フォルダと、中のフォント設定をまとめて削除します（確認します。Ctrl+Z で戻せます）" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="中のフォント設定" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="下の階層のものも含めて、上から順に並べています。押すとそのフォント設定を開きます。" Style="{StaticResource Note}" />
                            <GridView
                                x:Name="FolderFontsGrid"
                                ItemsSource="{x:Bind ViewModel.FolderFonts}"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnFolderFontClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FontListItem">
                                        <Grid Width="190" ColumnSpacing="6" Padding="2" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Border Width="12" Height="30" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind AfterBrush, Mode=OneWay}" />
                                                <Border Width="12" Height="30" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind BeforeBrush, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind UsageText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="EditorScroll" Visibility="{x:Bind ViewModel.Editor.HasFont, Mode=OneWay}">
                <StackPanel Spacing="12" Padding="0,0,16,16">

                    <!-- 基本 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="基本" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="NameBox"
                                    Header="名前"
                                    Text="{x:Bind ViewModel.Editor.NameText, Mode=OneWay}"
                                    KeyDown="OnNameKeyDown"
                                    LostFocus="OnNameLostFocus"
                                    ToolTipService.ToolTip="歌詞中のパート記号（@Emoji の置き換え文字列など。例:（花帆））と同じ名前にすると、その記号以降の文字に自動で適用されます。Enter で確定" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButtons x:Name="ScopeButtons" Header="範囲" MaxColumns="2" IsEnabled="False" SelectedIndex="{x:Bind ViewModel.Editor.ScopeIndex, Mode=OneWay}">
                                    <x:String>アプリ共通</x:String>
                                    <x:String>この曲専用</x:String>
                                </RadioButtons>
                                <Button
                                    x:Name="CopyToSongButton"
                                    VerticalAlignment="Bottom"
                                    Content="この曲専用にコピー"
                                    Visibility="{x:Bind ViewModel.Editor.IsCommon, Mode=OneWay}"
                                    ToolTipService.ToolTip="このフォント設定をこの曲専用に写します（名前はそのまま。この曲の書き出しでは曲専用が優先されます）"
                                    Click="OnCopyToSongClick" />
                                <Button
                                    x:Name="MoveToCommonButton"
                                    VerticalAlignment="Bottom"
                                    Content="アプリ共通へ移す"
                                    Visibility="{x:Bind ViewModel.Editor.IsSong, Mode=OneWay}"
                                    ToolTipService.ToolTip="この曲専用のフォント設定をアプリ共通へ移します（同じ名前のアプリ共通があれば置き換えるか確認します）"
                                    Click="OnMoveToCommonClick" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Editor.ScopeNote, Mode=OneWay}" Style="{StaticResource Note}" />
                            <InfoBar
                                x:Name="LinkBar"
                                Title="ニコカラメーカー3 のテンプレートと連動"
                                Severity="Informational"
                                IsClosable="False"
                                IsOpen="{x:Bind ViewModel.Editor.IsLinked, Mode=OneWay}"
                                Message="{x:Bind ViewModel.Editor.LinkText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Editor.LinkText, Mode=OneWay}" Style="{StaticResource Note}" Visibility="{x:Bind ViewModel.Editor.HasLinkNote, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="取り込み元:" Style="{StaticResource Note}" />
                                <TextBlock Text="{x:Bind ViewModel.Editor.ImportedFromText, Mode=OneWay}" Style="{StaticResource Note}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 配色 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="配色" Style="{StaticResource SectionTitle}" />
                            <!-- 8 箇所（上段 = ワイプ後、下段 = ワイプ前）。押した箇所を下の編集欄で編集する -->
                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ワイプ後" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="ワイプ前" FontSize="12" VerticalAlignment="Center" />
                                <ItemsRepeater x:Name="AfterCellsRepeater" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Editor.AfterCells}" ItemTemplate="{StaticResource BrushCellTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MaximumRowsOrColumns="4" MinItemWidth="64" MinItemHeight="60" MinColumnSpacing="6" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <ItemsRepeater x:Name="BeforeCellsRepeater" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Editor.BeforeCells}" ItemTemplate="{StaticResource BrushCellTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MaximumRowsOrColumns="4" MinItemWidth="64" MinItemHeight="60" MinColumnSpacing="6" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SwapButton" Content="前後を交換" Click="OnSwapClick" ToolTipService.ToolTip="ワイプ前とワイプ後の配色を入れ替えます" />
                                <Button x:Name="AfterToBeforeButton" Content="後→前へコピー" Click="OnAfterToBeforeClick" ToolTipService.ToolTip="ワイプ後の配色をワイプ前にコピーします" />
                                <Button x:Name="BeforeToAfterButton" Content="前→後へコピー" Click="OnBeforeToAfterClick" ToolTipService.ToolTip="ワイプ前の配色をワイプ後にコピーします" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CopyFromButton" Content="他のフォントから色をコピー...">
                                    <Button.Flyout>
                                        <Flyout x:Name="CopyFlyout" Opening="OnCopyFlyoutOpening" Placement="Bottom">
                                            <StackPanel Width="340" Spacing="8">
                                                <TextBlock Text="配色を写すもとのフォント設定" Style="{StaticResource PaneTitle}" />
                                                <TextBox x:Name="CopySearchBox" PlaceholderText="名前で検索" TextChanged="OnCopySearchChanged" />
                                                <ListView x:Name="CopySourceList" Height="240" SelectionMode="Single" SelectionChanged="OnCopySourceChanged">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FontListItem">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2">
                                                                <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind AfterBrush, Mode=OneWay}" />
                                                                <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind BeforeBrush, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind ScopeText}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <RadioButtons x:Name="CopyScopeButtons" SelectedIndex="0">
                                                    <x:String>8 箇所すべて</x:String>
                                                    <x:String>編集中の 1 箇所だけ</x:String>
                                                </RadioButtons>
                                                <Button x:Name="CopyBrushesButton" Content="コピー" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnCopyBrushesClick" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <fs:BrushEditor x:Name="BrushEditorPart" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- フォントフェース -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="フォントフェース" Style="{StaticResource SectionTitle}" />
                            <fs:FaceTable x:Name="FaceTablePart" />
                        </StackPanel>
                    </Border>

                    <!-- 文字飾り -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="文字飾り" Style="{StaticResource SectionTitle}" />
                            <RadioButtons x:Name="DecorKindButtons" Header="種類" MaxColumns="3" SelectedIndex="{x:Bind ViewModel.Editor.DecorKind, Mode=TwoWay}">
                                <x:String>なし</x:String>
                                <x:String>影</x:String>
                                <x:String>ブラー</x:String>
                            </RadioButtons>
                            <!-- 狭い画面でも欄がはみ出さないよう、種類の下に並べる -->
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <NumberBox
                                    x:Name="DecorSizeBox"
                                    Header="サイズ px"
                                    Width="130"
                                    VerticalAlignment="Top"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{x:Bind ViewModel.Editor.IsDecor, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.Editor.DecorSizeValue, Mode=TwoWay}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="ブラーの濃さ" />
                                    <Slider
                                        x:Name="BlurLevelSlider"
                                        Width="160"
                                        Minimum="0"
                                        Maximum="2"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        TickPlacement="Outside"
                                        SnapsTo="Ticks"
                                        IsEnabled="{x:Bind ViewModel.Editor.IsBlur, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.Editor.BlurLevel, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}" Text="サイズは、影なら文字をずらす距離、ブラーなら広がりです（画面の高さ 1080 を基準にした px）。飾りの色は配色の「飾り」で決めます。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= 右: プレビュー・使用状況・検証 ================= -->
        <Grid Grid.Column="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="プレビュー" Style="{StaticResource PaneTitle}" />
            <!-- プレビューの差し込み口（FontPreviewControl を入れる。PreviewTargetChanged で表示するフォント設定を知らせる） -->
            <Border
                x:Name="PreviewHost"
                x:FieldModifier="public"
                Grid.Row="1"
                Height="220"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <TextBlock Text="プレビュー（準備中）" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Note}" />
            </Border>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SampleBox" Header="サンプル" Text="永" TextChanged="OnSampleTextChanged" />
                <TextBox x:Name="RubyBox" Grid.Column="1" Header="ルビ" Text="えい" PlaceholderText="（なし）" TextChanged="OnSampleTextChanged" />
            </Grid>
            <TextBlock Grid.Row="3" Text="使用状況" Style="{StaticResource PaneTitle}" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" x:Name="UsageSummaryText" Text="{x:Bind ViewModel.UsageSummary, Mode=OneWay}" Style="{StaticResource Note}" />
            <ListView
                x:Name="UsageList"
                Grid.Row="5"
                SelectionMode="None"
                ItemsSource="{x:Bind ViewModel.UsageLines}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FontUsageLine">
                        <TextBlock Text="{x:Bind Text}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Text}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="6" Spacing="4">
                <Button
                    x:Name="AssignButton"
                    Content="{x:Bind ViewModel.AssignText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanAssign, Mode=OneWay}"
                    ToolTipService.ToolTip="このビューを開く前に行リストで選んでいた行に、このフォント設定を手動指定します（行リストの Ctrl+Z で戻せます）"
                    Click="OnAssignClick" />
                <TextBlock Text="{x:Bind ViewModel.AssignNote, Mode=OneWay}" Style="{StaticResource Note}" />
            </StackPanel>
            <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="検証" Style="{StaticResource PaneTitle}" />
                <TextBlock x:Name="IssueSummaryText" Text="{x:Bind ViewModel.IssueSummary, Mode=OneWay}" Style="{StaticResource Note}" VerticalAlignment="Center" />
            </StackPanel>
            <ListView
                x:Name="IssueList"
                Grid.Row="8"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnIssueClick"
                ItemsSource="{x:Bind ViewModel.Issues}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FontIssueItem">
                        <Grid ColumnSpacing="6" Padding="0,2" ToolTipService.ToolTip="{x:Bind Message}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{x:Bind GlyphBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{x:Bind SeverityText}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Message}" FontSize="12" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
