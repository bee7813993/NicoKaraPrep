<UserControl
    x:Class="NicoKaraPrep.App.Views.LineSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels"
    xmlns:views="using:NicoKaraPrep.App.Views">

    <UserControl.Resources>
        <CollectionViewSource x:Name="FontGroupsSource" IsSourceGrouped="True" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="PaneSelector" SelectionChanged="OnPaneChanged">
            <SelectorBarItem x:Name="FontPaneItem" Text="フォント" IsSelected="True" ToolTipService.ToolTip="押したフォント設定を、行リストで選んだ文字・行に指定します" />
            <SelectorBarItem x:Name="LayoutPaneItem" Text="レイアウト" ToolTipService.ToolTip="選んだ行のページのレイアウト設定（字幕の位置）と字幕アクションを指定します（レイアウト設定の編集はレイアウト設定ビュー（F4））" />
            <SelectorBarItem x:Name="ShowTimePaneItem" Text="表示時刻" ToolTipService.ToolTip="行の表示時刻の自動調整（パラメーターを変えて何度でも実行できます）" />
        </SelectorBar>

        <!-- フォント: 押すと、選んだ文字（文字を選んでいなければ選んだ行）にそのフォント設定を指定する -->
        <Grid Grid.Row="1" x:Name="FontPane" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="FontTargetText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="行リストで行か文字を選んでから、フォント設定を押してください" />
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FontSearchBox" PlaceholderText="名前で絞り込み" TextChanged="OnFontSearchChanged" />
                <Button Grid.Column="1" x:Name="FontAutoButton" Content="自動に戻す" Padding="8,4" Click="OnFontAutoClick"
                        ToolTipService.ToolTip="選んだ文字（文字を選んでいなければ選んだ行）のフォントの手動指定をやめ、パート記号で決まるフォント設定に戻します" />
            </Grid>
            <ListView
                Grid.Row="2"
                x:Name="FontPickList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnFontPickClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="8,0,8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:FontPickGroup">
                                <TextBlock Text="{x:Bind Key}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FontPickItem">
                        <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2" ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind After}" />
                            <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind Before}" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- レイアウト: 選んだ行のページのレイアウトと字幕アクションを選ぶ（選ぶとすぐに指定する）。
             レイアウト設定の値・追加・削除と、字幕アクションの曲の既定・設定値はレイアウト設定ビュー（F4）で編集する -->
        <ScrollViewer Grid.Row="1" x:Name="LayoutPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel Spacing="8">
                <TextBlock Text="選んだ行のページ" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="PageTargetText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="行リストで行を選ぶと、その行のページのレイアウトと字幕アクションを指定できます" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="レイアウト" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" x:Name="PageLayoutBox" HorizontalAlignment="Stretch" PlaceholderText="（自動）" SelectionChanged="OnPageLayoutChanged"
                              AutomationProperties.Name="選んだ行のページのレイアウト"
                              ToolTipService.ToolTip="選んだ行のページに使うレイアウト設定。選ぶとすぐに指定します（「（自動）」でページの行数から選びます。同じページの行すべてに効きます）" />
                    <TextBlock Grid.Row="1" Text="字幕アクション" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PageActionBox" HorizontalAlignment="Stretch" PlaceholderText="（既定）" SelectionChanged="OnPageActionChanged"
                              AutomationProperties.Name="選んだ行のページの字幕アクション"
                              ToolTipService.ToolTip="選んだ行のページに使う字幕アクション（ニコカラメーカー3 の行の出し方・消し方）。選ぶとすぐに指定します（「（既定）」で曲の既定に戻します。同じページの行すべてに効きます。設定値はその種類の既定値で、レイアウト設定ビュー（F4）で変えられます）" />
                </Grid>
                <TextBlock x:Name="PageActionDetail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="EditLayoutsButton" Content="レイアウト設定を編集..." HorizontalAlignment="Stretch" Click="OnEditLayoutsClick"
                        AutomationProperties.Name="レイアウト設定を編集"
                        ToolTipService.ToolTip="レイアウト設定ビュー（F4）を開いて、このページのレイアウト設定を選んだ状態で編集します（レイアウト設定の値・追加・削除、字幕アクションの曲の既定もここで変えます）" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"
                           Text="ここで選んだページの指定は、元に戻す（Ctrl+Z）で戻せます。レイアウト設定の値（位置・余白・行ごとの左右など）と、字幕アクションの曲の既定は、レイアウト設定ビュー（F4）で編集します。字幕アクションは字幕のプレビューには描きません。" />
            </StackPanel>
        </ScrollViewer>

        <!-- 表示時刻: 自動調整のパラメーター（アプリ共通）と実行。決めた表示時刻は行に持たせ、書き出し・プレビュー・チェックでそのまま使う -->
        <ScrollViewer Grid.Row="1" x:Name="ShowTimePane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel Spacing="8">
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="ニコカラメーカー3 の「自動で表示開始時刻・表示終了時刻を設定」と同じ計算で、行の表示時刻を決めます。決めた表示時刻は、書き出し・字幕のプレビュー・チェックでそのまま使います（パラメーターや歌詞を変えても、実行し直すまで変わりません）。" />
                <TextBlock x:Name="ShowTimeSummaryText" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Text="パラメーター（アプリ共通）" Style="{StaticResource SectionTitle}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ワイプ前（秒）" Style="{StaticResource FieldLabel}" />
                    <NumberBox Grid.Column="1" x:Name="StLeadBox" Minimum="0" Maximum="30" SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Compact"
                               ValueChanged="OnShowTimeNumberChanged" ToolTipService.ToolTip="行を歌い出しの何秒前から表示するか（ニコカラメーカーの「ワイプ前の表示時間」）" />
                    <TextBlock Grid.Row="1" Text="ワイプ後（秒）" Style="{StaticResource FieldLabel}" />
                    <NumberBox Grid.Row="1" Grid.Column="1" x:Name="StTailBox" Minimum="0" Maximum="30" SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Compact"
                               ValueChanged="OnShowTimeNumberChanged" ToolTipService.ToolTip="行を歌い終わりの何秒後まで表示するか（「ワイプ後の表示時間」）" />
                    <TextBlock Grid.Row="2" Text="表示間隔（秒）" Style="{StaticResource FieldLabel}" />
                    <NumberBox Grid.Row="2" Grid.Column="1" x:Name="StIntervalBox" Minimum="0" Maximum="30" SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Compact"
                               ValueChanged="OnShowTimeNumberChanged" ToolTipService.ToolTip="前のページの同じ段の行が消えてから次の行を出すまでの間隔。ページ区切りと段落区切り（間奏など）も分けます" />
                    <TextBlock Grid.Row="3" Text="最短表示後（秒）" Style="{StaticResource FieldLabel}" />
                    <NumberBox Grid.Row="3" Grid.Column="1" x:Name="StProtectBox" Minimum="0" Maximum="30" SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Compact"
                               ValueChanged="OnShowTimeNumberChanged" ToolTipService.ToolTip="次のページと重なるとき、前の行を歌い終わりの何秒後まで短縮してよいか（0 = 自動: ワイプ前後の小さい方の半分。ニコカラメーカーの表示保護時間）" />
                    <TextBlock Grid.Row="4" Text="重ねてよい（秒）" Style="{StaticResource FieldLabel}" />
                    <NumberBox Grid.Row="4" Grid.Column="1" x:Name="StOverlapBox" Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Compact"
                               ValueChanged="OnShowTimeNumberChanged" ToolTipService.ToolTip="前後のページの同じ段の行を、何秒まで重ねて表示してよいか（0 = 重ねない。ニコカラメーカー3 と同じ計算）。字幕アクションが「文字単位フェード」のときなど、少しの重なりなら見づらくない場合に使います（ニコカラメーカー3 には無い機能）" />
                </Grid>
                <CheckBox x:Name="StTopLongCheck" Click="OnShowTimeCheckClick" MinWidth="0">
                    <TextBlock TextWrapping="Wrap" Text="上段の行をページの最後まで表示する（上段歌詞を長めに表示）" />
                </CheckBox>
                <CheckBox x:Name="StEmojiYieldCheck" Click="OnShowTimeCheckClick" MinWidth="0"
                          AutomationProperties.Name="前のページの同じ段と重なるときは、絵文字の分だけ行の表示を遅らせる"
                          ToolTipService.ToolTip="絵文字の表示秒数は、ワイプ前の表示時間まで縮めます（表示秒数がそれより短い絵文字は縮めません）。それでも重なるときは、前の行のワイプ後を削ります。前の行のワイプ終了から歌い出しまでがそれより短いときだけ、前の行をワイプの最後まで見せるため、さらに縮めます">
                    <TextBlock TextWrapping="Wrap" Text="前のページの同じ段と重なるときは、絵文字の分だけ行の表示を遅らせる（ニコカラメーカー3 には無い機能）" />
                </CheckBox>
                <CheckBox x:Name="StLayoutAwareCheck" Click="OnShowTimeCheckClick" MinWidth="0"
                          AutomationProperties.Name="レイアウトで画面の位置が違う行は、前後のページの同じ段でも重ならないものとして扱う"
                          ToolTipService.ToolTip="字幕のプレビューで重ならない行（上寄せ 5 行のページの次の下寄せ 2 行のページ、左寄せ 5 行と右寄せ 5 行のページなど）は、表示時刻を詰めず、チェックのページ衝突・表示時刻でも知らせません。ニコカラメーカー3 は段（下から何行目）だけで組にするので、外すと同じ計算になります">
                    <TextBlock TextWrapping="Wrap" Text="レイアウトで画面の位置が違う行は、前後のページの同じ段でも重ならないものとして扱う（ニコカラメーカー3 には無い機能）" />
                </CheckBox>
                <!-- 値を添えると長くなるので、パネルの幅で折り返す（切れないように） -->
                <Button x:Name="StImportNkm3Button" FontSize="12" Padding="8,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStImportNkm3Click" Visibility="Collapsed">
                    <TextBlock x:Name="StImportNkm3Text" Text="ニコカラメーカーの設定値を取り込む" TextWrapping="Wrap" />
                </Button>

                <Button x:Name="RunAutoShowTimeButton" Content="自動調整を実行" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                        Click="OnRunAutoShowTimeClick" ToolTipService.ToolTip="今のパラメーターで、全タブの行の表示時刻を決め直します（元に戻すで、歌詞設定タブごとに戻せます）" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="手で直した表示時刻（行リストの ✎・行設定の欄の値）はそのままにして、ほかの行（読み込んだ値・前回の自動調整の値・未設定）を計算し直します。表示時刻を持たない行は、パラメーターを変えるとすぐに計算し直します。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
