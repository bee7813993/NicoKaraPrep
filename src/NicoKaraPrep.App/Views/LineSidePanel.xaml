<UserControl
    x:Class="NicoKaraPrep.App.Views.LineSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels"
    xmlns:views="using:NicoKaraPrep.App.Views">

    <UserControl.Resources>
        <CollectionViewSource x:Name="FontGroupsSource" IsSourceGrouped="True" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- 「レイアウト」タブの一覧の 1 行（印・名前・説明） -->
        <DataTemplate x:Key="SidePickTemplate" x:DataType="views:SidePickItem">
            <Grid ColumnSpacing="6" Padding="0,2" ToolTipService.ToolTip="{x:Bind ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Mark}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Detail}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="PaneSelector" SelectionChanged="OnPaneChanged">
            <SelectorBarItem x:Name="FontPaneItem" Text="フォント" IsSelected="True" ToolTipService.ToolTip="押したフォント設定を、行リストで選んだ文字・行に指定します" />
            <SelectorBarItem x:Name="LayoutPaneItem" Text="レイアウト" ToolTipService.ToolTip="押したレイアウト設定（字幕の位置）を、行リストで選んだ行のページに指定します（作る・直すのはレイアウト設定ビュー（F4））" />
            <SelectorBarItem x:Name="ActionPaneItem" Text="字幕アクション" ToolTipService.ToolTip="押した字幕アクション（ニコカラメーカー3 の行の出し方・消し方）を、行リストで選んだ行に指定します" />
        </SelectorBar>

        <!-- フォント: 押すと、選んだ文字（文字を選んでいなければ選んだ行）にそのフォント設定を指定する -->
        <Grid Grid.Row="1" x:Name="FontPane" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="FontTargetText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="行リストで行か文字を選んでから、フォント設定を押してください" />
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FontSearchBox" PlaceholderText="名前で絞り込み" TextChanged="OnFontSearchChanged" />
                <Button Grid.Column="1" x:Name="FontAutoButton" Content="自動に戻す" Padding="8,4" Click="OnFontAutoClick"
                        ToolTipService.ToolTip="選んだ文字（文字を選んでいなければ選んだ行）のフォントの手動指定をやめ、パート記号で決まるフォント設定に戻します" />
            </Grid>
            <ListView
                Grid.Row="2"
                x:Name="FontPickList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnFontPickClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="8,0,8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:FontPickGroup">
                                <TextBlock Text="{x:Bind Key}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FontPickItem">
                        <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2" ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind After}" />
                            <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind Before}" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- レイアウト: 押したレイアウト設定を、行リストで選んだ行のページに指定する（フォントのタブと同じ使い方）。
             レイアウト設定の値・追加・削除はレイアウト設定ビュー（F4）で編集する -->
        <Grid Grid.Row="1" x:Name="LayoutPane" Visibility="Collapsed" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LayoutTargetText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="行リストで行を選んでから、レイアウト設定を押してください" />
            <TextBlock Grid.Row="1" x:Name="PageLayoutNote" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView
                Grid.Row="2"
                x:Name="PageLayoutList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnPageLayoutClick"
                ItemTemplate="{StaticResource SidePickTemplate}"
                AutomationProperties.Name="レイアウト設定の一覧（押すと選んだ行のページに指定）">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="8,0,8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <StackPanel Grid.Row="3" Spacing="4">
                <Button x:Name="EditLayoutsButton" Content="レイアウト設定を編集..." HorizontalAlignment="Stretch" Click="OnEditLayoutsClick"
                        AutomationProperties.Name="レイアウト設定を編集"
                        ToolTipService.ToolTip="レイアウト設定ビュー（F4）を開いて、このページのレイアウト設定を選んだ状態で編集します（レイアウト設定の値・追加・削除）" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="押した指定は、元に戻す（Ctrl+Z）で戻せます。レイアウト設定の値・追加・削除は、レイアウト設定ビュー（F4）で行います。" />
            </StackPanel>
        </Grid>

        <!-- 字幕アクション: 押した字幕アクションを、行リストで選んだ行（「ページの行すべてにそろえる」ならそのページ）に指定する（フォントのタブと同じ使い方）。
             曲の既定（行ごとに指定していない行に使うもの）の種類と設定値は「曲の既定を設定...」のポップアップで編集する -->
        <Grid Grid.Row="1" x:Name="ActionPane" Visibility="Collapsed" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ActionTargetText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="行リストで行を選んでから、字幕アクションを押してください" />
            <StackPanel Grid.Row="1" Spacing="2">
                <CheckBox x:Name="PageActionWholePageCheck" Content="ページの行すべてにそろえる" MinWidth="0" Click="OnPageActionWholePageClick"
                          ToolTipService.ToolTip="入れると、押した字幕アクションを、選んだ行のページの行すべてに指定します（ニコカラメーカー3 でページごとに使い分けるとき）。外すと、選んだ行だけに指定します（フォントと同じ）" />
                <TextBlock x:Name="PageActionNote" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ListView
                Grid.Row="2"
                x:Name="PageActionList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnPageActionClick"
                ItemTemplate="{StaticResource SidePickTemplate}"
                AutomationProperties.Name="字幕アクションの一覧（押すと選んだ行に指定）">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="8,0,8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock x:Name="SongActionText" FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="SongActionButton" Content="曲の既定を設定..." HorizontalAlignment="Stretch" Click="OnSongActionClick"
                        AutomationProperties.Name="字幕アクションの曲の既定を設定"
                        ToolTipService.ToolTip="行ごとに字幕アクションを指定していない歌詞行に使う、曲の既定の種類と設定値（時間など）を選びます（この曲の .tttproj に保存します）" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="押した指定は、元に戻す（Ctrl+Z）で戻せます。字幕アクションは字幕のプレビューには描きません。" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
