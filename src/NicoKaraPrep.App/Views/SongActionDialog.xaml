<ContentDialog
    x:Class="NicoKaraPrep.App.Views.SongActionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="字幕アクションの曲の既定"
    PrimaryButtonText="OK"
    CloseButtonText="キャンセル"
    DefaultButton="None">
    <!-- DefaultButton を付けない: 数値の欄で値を確定する Enter で、確定する前に OK にならないように -->

    <!-- 行ごとに指定していない歌詞行に書き出す字幕アクション（曲の既定。.tttproj に保存）。種類と設定値を選ぶ。OK で書き込む -->
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Width="480" Spacing="10">
            <TextBlock
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="行ごとに字幕アクションを指定していない歌詞行に、n3proj の書き出しで使う字幕アクションです（この曲の .tttproj に保存します）。行ごと・ページごとの指定は、行リストの右のパネル「字幕アクション」で行います。" />
            <ComboBox
                x:Name="KindBox"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnKindChanged"
                AutomationProperties.Name="曲の既定の字幕アクション"
                ToolTipService.ToolTip="自動にすると、ベースの n3proj の歌詞行でいちばん多いもの → ニコカラメーカー3 の「すべて同じ字幕アクションにする」の設定 → 文字単位フェード の順に決めます" />
            <Button
                x:Name="ResetButton"
                Content="ニコカラメーカー3 の設定に戻す"
                Click="OnResetClick"
                ToolTipService.ToolTip="選んでいる字幕アクションの値を、ニコカラメーカー3 の設定の値（ニコカラメーカー3 で新しい行に使う値。設定フォルダの AddOns。設定を変えていなければニコカラメーカー3 の初期値）に戻します" />
            <!-- 選んだ種類の設定項目（時間・大きさの欄は 2 列、する・しないは下に並べる） -->
            <Grid x:Name="NumbersGrid" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
            <StackPanel x:Name="ChecksPanel" Spacing="2" />
            <TextBlock x:Name="FieldsNote" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="NoteText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
