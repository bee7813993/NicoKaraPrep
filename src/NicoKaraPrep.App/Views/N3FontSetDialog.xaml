<ContentDialog
    x:Class="NicoKaraPrep.App.Views.N3FontSetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views"
    Title="ニコカラメーカー3 のフォント設定"
    PrimaryButtonText="OK"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <Grid RowSpacing="8" MinWidth="980">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            TextWrapping="Wrap"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="n3proj 書き出し時に、ニコカラメーカーの「フォント設定」タブとして出力されます（ベースに同名の設定があればフォント・単色の配色・文字飾りを上書き）。名称を @Emoji の置き換え文字列（例: （花帆））と同じにすると、その記号以降の文字に自動で適用されます。色は 16 進 6 桁（例: FF5800）。空欄はベースの値を維持します。" />

        <Grid Grid.Row="1" ColumnSpacing="6" Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="名称" FontSize="12" />
            <TextBlock Grid.Column="1" Text="フォント" FontSize="12" />
            <TextBlock Grid.Column="2" Text="フェイス" FontSize="12" />
            <TextBlock Grid.Column="3" Text="サイズpx" FontSize="12" />
            <TextBlock Grid.Column="4" Text="縁px" FontSize="12" />
            <TextBlock Grid.Column="5" Text="文字色(後)" FontSize="12" />
            <TextBlock Grid.Column="6" Text="縁色(後)" FontSize="12" />
            <TextBlock Grid.Column="7" Text="文字色(前)" FontSize="12" />
            <TextBlock Grid.Column="8" Text="縁色(前)" FontSize="12" />
            <TextBlock Grid.Column="9" Text="操作" FontSize="12" />
        </Grid>

        <ListView
            Grid.Row="2"
            x:Name="RowList"
            MaxHeight="360"
            SelectionMode="Single"
            SelectionChanged="OnRowSelectionChanged"
            ItemsSource="{x:Bind Rows}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:N3FontRow">
                    <Grid ColumnSpacing="6" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind Name, Mode=TwoWay}" FontSize="12" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind FontChoices}" Text="{x:Bind FontFamily, Mode=TwoWay}" IsEditable="True" HorizontalAlignment="Stretch" FontSize="12" />
                        <TextBox Grid.Column="2" Text="{x:Bind FontFace, Mode=TwoWay}" FontSize="12" PlaceholderText="Bold" />
                        <TextBox Grid.Column="3" Text="{x:Bind SizeText, Mode=TwoWay}" FontSize="12" />
                        <TextBox Grid.Column="4" Text="{x:Bind EdgeText, Mode=TwoWay}" FontSize="12" />
                        <TextBox Grid.Column="5" Text="{x:Bind TextColorAfter, Mode=TwoWay}" FontSize="12" MaxLength="7" />
                        <TextBox Grid.Column="6" Text="{x:Bind EdgeColorAfter, Mode=TwoWay}" FontSize="12" MaxLength="7" />
                        <TextBox Grid.Column="7" Text="{x:Bind TextColorBefore, Mode=TwoWay}" FontSize="12" MaxLength="7" />
                        <TextBox Grid.Column="8" Text="{x:Bind EdgeColorBefore, Mode=TwoWay}" FontSize="12" MaxLength="7" />
                        <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="2">
                            <Button Content="複" FontSize="11" Padding="6,2" MinWidth="0" Click="OnDuplicateRowClick" Tag="{x:Bind}" ToolTipService.ToolTip="この行を複製" />
                            <Button Content="↑" FontSize="11" Padding="6,2" MinWidth="0" Click="OnMoveUpClick" Tag="{x:Bind}" />
                            <Button Content="↓" FontSize="11" Padding="6,2" MinWidth="0" Click="OnMoveDownClick" Tag="{x:Bind}" />
                            <Button Content="✕" FontSize="11" Padding="6,2" MinWidth="0" Click="OnDeleteRowClick" Tag="{x:Bind}" ToolTipService.ToolTip="この行を削除" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 選択行の詳細（縁 2・文字飾り・ルビ） -->
        <Border
            Grid.Row="3"
            Padding="12,8"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="DetailCaption" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="行を選択すると詳細（縁 2・文字飾り・ルビ）を編集できます" />
                <Grid x:Name="DetailPanel" IsHitTestVisible="False" Opacity="0.5" ColumnSpacing="8" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="UseEdge2Check" Grid.Row="0" Grid.Column="0" Content="縁 2 を付ける" MinWidth="0" VerticalAlignment="Bottom" Click="OnDetailChanged" />
                    <NumberBox x:Name="Edge2Box" Grid.Row="0" Grid.Column="1" Header="縁 2 の幅 px" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnDetailValueChanged" />
                    <TextBox x:Name="Edge2AfterBox" Grid.Row="0" Grid.Column="2" Header="縁 2 色(後)" MaxLength="7" TextChanged="OnDetailTextChanged" />
                    <TextBox x:Name="Edge2BeforeBox" Grid.Row="0" Grid.Column="3" Header="縁 2 色(前)" MaxLength="7" TextChanged="OnDetailTextChanged" />
                    <NumberBox x:Name="RubySizeBox" Grid.Row="0" Grid.Column="4" Header="ルビサイズ px (0=半分)" Minimum="0" Maximum="400" SpinButtonPlacementMode="Compact" ValueChanged="OnDetailValueChanged" />
                    <NumberBox x:Name="RubyEdgeBox" Grid.Row="0" Grid.Column="5" Header="ルビ縁 px (0=半分)" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnDetailValueChanged" />
                    <ComboBox x:Name="DecorKindBox" Grid.Row="1" Grid.Column="0" Header="文字飾り" HorizontalAlignment="Stretch" SelectionChanged="OnDetailSelectionChanged">
                        <ComboBoxItem Content="なし" />
                        <ComboBoxItem Content="影" />
                        <ComboBoxItem Content="ブラー" />
                    </ComboBox>
                    <NumberBox x:Name="DecorSizeBox" Grid.Row="1" Grid.Column="1" Header="飾りサイズ px" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnDetailValueChanged" />
                    <TextBox x:Name="DecorAfterBox" Grid.Row="1" Grid.Column="2" Header="飾り色(後)" MaxLength="7" TextChanged="OnDetailTextChanged" />
                    <TextBox x:Name="DecorBeforeBox" Grid.Row="1" Grid.Column="3" Header="飾り色(前)" MaxLength="7" TextChanged="OnDetailTextChanged" />
                    <ComboBox x:Name="BlurLevelBox" Grid.Row="1" Grid.Column="4" Header="ブラーの濃さ" HorizontalAlignment="Stretch" SelectionChanged="OnDetailSelectionChanged">
                        <ComboBoxItem Content="薄い" />
                        <ComboBoxItem Content="普通" />
                        <ComboBoxItem Content="濃い" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="＋ 追加" Click="OnAddRowClick" />
            <Button Content="現在の字幕フォント設定から追加" Click="OnAddFromSettingsClick" ToolTipService.ToolTip="ファイル > 設定 の字幕フォント・サイズ・縁取りを「標準」として追加" />
            <Button Content="n3proj から取り込み..." Click="OnImportClick" ToolTipService.ToolTip="既存プロジェクトのフォント設定（単色の配色・サイズ・文字飾り）を行として取り込む" />
        </StackPanel>
    </Grid>
</ContentDialog>
