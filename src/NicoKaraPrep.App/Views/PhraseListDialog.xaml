<ContentDialog
    x:Class="NicoKaraPrep.App.Views.PhraseListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoKaraPrep.App.Views"
    xmlns:vm="using:NicoKaraPrep.App.ViewModels"
    Title="定型文の編集"
    PrimaryButtonText="OK"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <!-- 絵文字挿入ビューで入れる決まった文字列（アプリ共通。上から 10 件に N のあとの番号 1–0）と、定型文に使うフォント設定 -->
    <StackPanel x:Name="RootPanel" Width="480" Spacing="8">
        <StackPanel.Resources>
            <!-- フォント設定の ▼ で開く一覧（絵文字のリストの「文字」の ▼ と同じ見た目） -->
            <DataTemplate x:Key="FontNameItemTemplate" x:DataType="vm:FontPickItem">
                <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2" ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind After}" />
                    <Border Width="10" Height="22" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{x:Bind Before}" />
                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="FontNameGroupTemplate" x:DataType="vm:FontPickGroup">
                <TextBlock Text="{x:Bind Key}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </DataTemplate>
        </StackPanel.Resources>

        <TextBlock
            TextWrapping="Wrap"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="絵文字挿入ビューで、パレットの「定型文」を押すか、N のあとに番号（1–0）を押すと、カーソルの位置に入れます。行頭・行末・空行に入れると、定型文だけのページにして（前後に空行を置きます）、前後のページと表示が重ならない時刻にします（前のページが消えてからワイプ前の秒数のあと 〜 次のページが出るワイプ後の秒数前まで画面に出します。後奏は曲の終わりまで）。行の途中なら、直前の文字の終わりから直後の文字の始まりまでです。文字列の中の {秒} は前後の歌のあいだの秒数になります（例: （間奏 約{秒}秒） → （間奏 約14秒））。入れた定型文は BS / Del でまとめて消せます。" />
        <ListView
            x:Name="RowList"
            MaxHeight="300"
            SelectionMode="None"
            ItemsSource="{x:Bind Rows}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PhraseRow">
                    <Grid ColumnSpacing="6" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind KeyLabel, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBox Grid.Column="1" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="（後奏）" AutomationProperties.Name="定型文" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Content="↑" FontSize="11" Padding="6,2" MinWidth="0" Click="OnMoveUpClick" Tag="{x:Bind}" ToolTipService.ToolTip="上へ（番号も入れ替わります）" />
                            <Button Content="↓" FontSize="11" Padding="6,2" MinWidth="0" Click="OnMoveDownClick" Tag="{x:Bind}" ToolTipService.ToolTip="下へ" />
                            <Button Content="✕" FontSize="11" Padding="6,2" MinWidth="0" Click="OnDeleteClick" Tag="{x:Bind}" ToolTipService.ToolTip="この定型文を削除" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!-- 行を足す操作（どちらも一覧の末尾に足すので、同じ行に並べる） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" Content="＋ 定型文を追加" Click="OnAddClick" />
            <Button
                x:Name="AddDefaultsButton"
                Content="既定の定型文を足す"
                Click="OnAddDefaultsClick"
                ToolTipService.ToolTip="（前奏）（間奏 約{秒}秒）（後奏）のうち、まだ無いものを末尾に足します（今ある定型文はそのまま）" />
        </StackPanel>

        <!-- 定型文に使うフォント設定（全部の定型文で同じ） -->
        <StackPanel Spacing="4" Margin="0,8,0,0">
            <TextBlock Text="定型文に使うフォント設定（全部の定型文で同じ）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FontBox"
                    PlaceholderText="指定しない"
                    TextChanged="OnFontBoxChanged"
                    AutomationProperties.Name="定型文に使うフォント設定" />
                <Button
                    x:Name="PickFontButton"
                    Grid.Column="1"
                    Padding="6,4"
                    MinWidth="0"
                    VerticalAlignment="Stretch"
                    Click="OnPickFontClick"
                    AutomationProperties.Name="フォント設定の名前から選ぶ"
                    ToolTipService.ToolTip="フォント設定の名前から選ぶ">
                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                </Button>
            </Grid>
            <TextBlock
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="定型文だけの行は行に、行の途中に入れた定型文は文字に、このフォント設定を指定します（行設定のフォントの手動指定と同じ）。空欄なら指定しません。これから入れる定型文に使います。" />
            <TextBlock
                x:Name="FontWarningText"
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
